    "移到废纸篓前仍需要你确认" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your confirmation is still required before moving anything to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "移到廢紙簍前仍需要你確認" } } } },
    "等待你决定" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Awaiting Your Decision" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "等待你決定" } } } },
    "等待读取" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for Data" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "等待讀取" } } } },
