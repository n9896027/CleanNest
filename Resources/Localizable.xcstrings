    "已读取内存容量，但还没有足够数据判断当前压力。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Memory capacity is available, but there is not enough data yet to assess pressure." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已讀取記憶體容量，但還沒有足夠資料判斷目前壓力。" } } } },
    "“已使用”较高不等于故障" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "High used memory does not mean a fault" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「已使用」較高不等於故障" } } } },
    "macOS 会主动使用空闲内存做缓存，需要时会自动释放。交换空间已有占用，也不等于此刻仍在频繁换页；应结合内存压力和连续采样判断。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS uses free memory for cache and releases it when needed. Existing swap usage alone does not prove active paging; consider memory pressure and continuous samples." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 會主動使用閒置記憶體作為快取，需要時會自動釋放。交換空間已有佔用，也不代表此刻仍在頻繁換頁；應結合記憶體壓力與持續採樣判斷。" } } } },
    "按近似内存足迹排序；系统或受保护进程只展示，不会提供结束按钮。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sorted by approximate memory footprint. System and protected processes are shown without a quit action." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "按近似記憶體足跡排序；系統或受保護程序只顯示，不提供結束按鈕。" } } } },
    "已探测 %d 个进程" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d processes detected" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已探測 %d 個程序" } } } },
    "近似内存足迹" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Approximate footprint" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "近似記憶體足跡" } } } },
