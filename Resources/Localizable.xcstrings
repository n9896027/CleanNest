    "正在检查回环服务与所选模型。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking the loopback service and selected model." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢查回環服務與所選模型。" } } } },
    "大型模型首次载入可能需要几十秒，界面仍可继续使用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A large model may take tens of seconds to load the first time; the interface remains usable." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "大型模型首次載入可能需要數十秒，介面仍可繼續使用。" } } } },
    "正在安全结束由 CleanNest 启动的模型进程。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safely stopping the model process started by CleanNest." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在安全結束由 CleanNest 啟動的模型程序。" } } } },
    "启用本机 AI 分析" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable On-device AI Analysis" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用本機 AI 分析" } } } },
    "关闭后普通规则扫描仍可使用；只会停止由 CleanNest 自己启动的模型进程。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Regular rule-based scans remain available when off. Only model processes started by CleanNest are stopped." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉後一般規則掃描仍可使用；只會停止由 CleanNest 自行啟動的模型程序。" } } } },
