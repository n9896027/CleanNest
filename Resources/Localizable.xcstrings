    "最大容量 %d%%" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Maximum Capacity %d%%" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "最大容量 %d%%" } } } },
    "%d 次循环" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d cycles" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 次循環" } } } },
    "预计剩余 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ remaining" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "預計剩餘 %@" } } } },
    "压缩内存约 %@：这是系统压缩暂时不用的数据，不是可以删除的文件缓存。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "About %@ is compressed memory. This is data compressed by the system, not a deletable file cache." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "壓縮記憶體約 %@：這是系統壓縮暫時不用的資料，不是可刪除的檔案快取。" } } } },
    "交换空间已使用 %@；单次看到已有占用不代表此刻仍在频繁交换，应结合压力状态和持续卡顿判断。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ of swap is in use. A single nonzero reading does not prove active swapping; consider pressure state and sustained slowdown." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "交換空間已使用 %@；單次看到已有佔用不代表此刻仍在頻繁交換，應結合壓力狀態與持續卡頓判斷。" } } } },
    "本次单个内存足迹最高的是 %@，约 %@；可刷新后观察是否持续增长。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ has the largest sampled footprint at about %@. Refresh later to see whether it keeps growing." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本次單一記憶體足跡最高的是 %@，約 %@；可重新整理後觀察是否持續增長。" } } } },
    "“%@”的辅助进程；未读取命令行参数，无法确认更具体的职责。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A helper process for “%@”. Command-line arguments were not read, so its exact role is unknown." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「%@」的輔助程序；未讀取命令列參數，無法確認更具體的職責。" } } } },
    "“%@”的应用进程。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "An application process for “%@”." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「%@」的 App 程序。" } } } },
    "刷新变化" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh Changes" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新整理變更" } } } },
    "深度刷新（忽略缓存）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Deep Refresh (Ignore Cache)" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "深度重新整理（忽略快取）" } } } },
    "清空增量索引" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear Incremental Index" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "清除增量索引" } } } },
    "原生增量索引" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Native Incremental Index" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "原生增量索引" } } } },
    "扫描会持续显示已完成的部分结果；15 分钟内只复用元数据签名未变化的项目。需要实时重算时可选择“深度刷新”。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Completed partial results appear while scanning. Unchanged metadata signatures may be reused for 15 minutes; use Deep Refresh for a full live recalculation." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "掃描時會持續顯示已完成的部分結果；15 分鐘內只重用中繼資料簽章未變的項目。需要即時重算時可選擇「深度重新整理」。" } } } },
    "索引状态" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Index Status" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "索引狀態" } } } },
    "实时更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Updating Live" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "即時更新" } } } },
    "完整结果" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Complete Result" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "完整結果" } } } },
    "缓存命中会明确标注" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cache reuse is always disclosed" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "快取命中會明確標示" } } } },
    "清理决策中心" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cleanup Decision Center" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "清理決策中心" } } } },
    "先看确定性证据，再决定下一步。模型无法改变这里的风险下限或动作边界。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review deterministic evidence before acting. A model cannot lower the risk floor or expand the allowed action here." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "先看確定性證據，再決定下一步。模型無法改變此處的風險下限或動作邊界。" } } } },
    "系统先给出确定性证据；你可以手动改为待复核、保留或稍后处理。模型和手动选择都不能突破安全边界。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Deterministic evidence comes first. You can manually mark an item for review, keep it, or decide later. Neither a model nor a manual choice can bypass safety boundaries." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "系統先提供確定性證據；你可以手動改為待複核、保留或稍後處理。模型與手動選擇都不能突破安全邊界。" } } } },
    "全部" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "All" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "全部" } } } },
    "可复核" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reviewable" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可複核" } } } },
    "待复核" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "To Review" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "待複核" } } } },
    "App 内管理" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage in App" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 App 內管理" } } } },
    "保留" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "保留" } } } },
    "我的决定" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "My Decisions" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "我的決定" } } } },
    "跟随建议" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow Advice" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "跟隨建議" } } } },
    "待清理复核" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review for Cleanup" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "待清理複核" } } } },
    "稍后处理" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Decide Later" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "稍後處理" } } } },
    "你的决定" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your Decision" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你的決定" } } } },
    "保存在本机" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stored on This Mac" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "儲存在本機" } } } },
    "你的决定：待清理复核" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your decision: Review for cleanup" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你的決定：待清理複核" } } } },
    "你的决定：保留" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your decision: Keep" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你的決定：保留" } } } },
    "你的决定：稍后处理" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your decision: Decide later" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你的決定：稍後處理" } } } },
    "系统建议 · %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System Advice · %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "系統建議 · %@" } } } },
    "已手动调整" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manually Adjusted" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已手動調整" } } } },
    "前往安全清理页" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Safe Cleanup" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "前往安全清理頁" } } } },
    "不自动删除" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Automatic Deletion" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不自動刪除" } } } },
    "“待清理复核”会把它保留在待复核列表，但不会自动勾选或删除；实际处理仍需进入安全清理页再次确认。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review for Cleanup keeps the item in your review list but never selects or deletes it automatically. Confirm again on the safe cleanup page before acting." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「待清理複核」會把它保留在待複核清單，但不會自動勾選或刪除；實際處理仍需進入安全清理頁再次確認。" } } } },
    "此项目受保护、风险较高或应由所属 App 管理，因此不能标为待清理；你仍可选择保留、稍后处理或跟随系统。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This item is protected, higher risk, or should be managed in its owning app, so it cannot be marked for cleanup. You can still keep it, decide later, or follow system advice." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此項目受保護、風險較高或應由所屬 App 管理，因此不能標為待清理；你仍可選擇保留、稍後處理或跟隨系統。" } } } },
    "用途" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Purpose" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "用途" } } } },
    "为何变大" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Why It Grows" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "為何變大" } } } },
    "处理影响" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Impact" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "處理影響" } } } },
    "进入下一层" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Next Level" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "進入下一層" } } } },
    "在 Finder 中确认" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Verify in Finder" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 Finder 中確認" } } } },
    "此页只读" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only Page" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此頁唯讀" } } } },
    "高证据" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Strong Evidence" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "高證據" } } } },
