    "已读取内存容量，但还没有足够数据判断当前压力。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Memory capacity is available, but there is not enough data yet to assess pressure." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已讀取記憶體容量，但還沒有足夠資料判斷目前壓力。" } } } },
    "“已使用”较高不等于故障" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "High used memory does not mean a fault" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「已使用」較高不等於故障" } } } },
    "macOS 会主动使用空闲内存做缓存，需要时会自动释放。交换空间已有占用，也不等于此刻仍在频繁换页；应结合内存压力和连续采样判断。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS uses free memory for cache and releases it when needed. Existing swap usage alone does not prove active paging; consider memory pressure and continuous samples." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 會主動使用閒置記憶體作為快取，需要時會自動釋放。交換空間已有佔用，也不代表此刻仍在頻繁換頁；應結合記憶體壓力與持續採樣判斷。" } } } },
    "按近似内存足迹排序；系统或受保护进程只展示，不会提供结束按钮。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sorted by approximate memory footprint. System and protected processes are shown without a quit action." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "按近似記憶體足跡排序；系統或受保護程序只顯示，不提供結束按鈕。" } } } },
    "已探测 %d 个进程" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d processes detected" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已探測 %d 個程序" } } } },
    "近似内存足迹" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Approximate footprint" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "近似記憶體足跡" } } } },
    "退出…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quit…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "結束…" } } } },
    "操作没有完成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Action Not Completed" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "操作未完成" } } } },
    "进程状态已更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Process Status Updated" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "程序狀態已更新" } } } },
    "还没有进程数据" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Process Data Yet" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚無程序資料" } } } },
    "点击页面右上角的“刷新”，重新探测当前内存占用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use Refresh in the top-right corner to sample current memory usage again." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "點擊頁面右上角的「重新整理」，重新探測目前記憶體佔用。" } } } },
    "只显示前 10 项" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show Top 10 Only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只顯示前 10 項" } } } },
    "整体运行平稳" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Running Smoothly" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "整體執行平穩" } } } },
    "状态分数只是资源占用的即时参考，不等同于硬件健康诊断。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The status score is a point-in-time resource reference, not a hardware health diagnosis." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "狀態分數只是資源佔用的即時參考，不等同於硬體健康診斷。" } } } },
    "参考" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reference" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "參考" } } } },
    "只读检查" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only Check" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀檢查" } } } },
    "状态数据不完整" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Status Data Incomplete" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "狀態資料不完整" } } } },
    "资源占用值得留意" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resource Usage Needs Attention" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "資源佔用值得留意" } } } },
    "当前负载较高" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current Load Is High" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前負載較高" } } } },
    "macOS 仍有足够内存可供应用使用，无需为了降低“已用”百分比而关闭 App。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS still has enough memory for apps. There is no need to quit apps merely to lower the used percentage." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 仍有足夠記憶體可供 App 使用，無需為了降低「已用」百分比而關閉 App。" } } } },
    "内存占用高不等于内存不足。macOS 会主动利用空闲内存做缓存，并在其他 App 需要时回收。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "High memory usage is not the same as low memory. macOS uses free memory for cache and reclaims it when other apps need it." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "記憶體佔用高不等於記憶體不足。macOS 會主動利用閒置記憶體作為快取，並在其他 App 需要時回收。" } } } },
    "下方进程数值是单次采样的内存足迹近似值；共享内存、压缩内存和统一内存的计算方式不同，进程相加不会等于系统已用内存。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Process values below are approximate footprints from one sample. Shared, compressed, and unified memory are counted differently, so process totals will not equal system used memory." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下方程序數值是單次採樣的記憶體足跡近似值；共享記憶體、壓縮記憶體和統一記憶體的計算方式不同，程序相加不會等於系統已用記憶體。" } } } },
    "Python 运行时；常见于本机 AI、数据处理或开发脚本。为保护隐私，CleanNest 未读取命令行参数，因此不能确认具体项目。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Python runtime, commonly used by on-device AI, data processing, or developer scripts. CleanNest does not read command-line arguments, so it cannot identify the specific project." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Python 執行環境；常見於本機 AI、資料處理或開發腳本。為保護隱私，CleanNest 未讀取命令列參數，因此無法確認具體專案。" } } } },
    "未读取命令行参数，无法确认该进程的具体用途。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Command-line arguments were not read, so this process's exact purpose is unknown." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未讀取命令列參數，無法確認該程序的具體用途。" } } } },
    "每 60 秒本机采样；保留 %d 天，不上传。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sampled locally every 60 seconds; retained for %d days and never uploaded." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每 60 秒本機採樣；保留 %d 天，不上傳。" } } } },
    "每 60 秒本机采样；当前显示 %d 个数据点。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sampled locally every 60 seconds; showing %d data points." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每 60 秒本機採樣；目前顯示 %d 個資料點。" } } } },
    "选择…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇…" } } } },
    "重新检测" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check Again" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新檢測" } } } },
    "保持 CLI 为独立本地进程，方便以后更新或替换引擎。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep the CLI as an independent local process so the engine can be updated or replaced later." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "保持 CLI 為獨立本機程序，方便日後更新或替換引擎。" } } } },
    "检查更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check for Updates" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "檢查更新" } } } },
    "检查更新…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check for Updates…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "檢查更新…" } } } },
    "操作" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Actions" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "操作" } } } },
    "软件更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Software Update" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "軟體更新" } } } },
    "正在检查…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢查…" } } } },
    "重新检查" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check Again" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新檢查" } } } },
    "打开 GitHub 下载" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open GitHub Download" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟 GitHub 下載" } } } },
    "查看 GitHub 发布页" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "View GitHub Releases" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "查看 GitHub 發布頁" } } } },
    "版本说明" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Release Notes" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "版本說明" } } } },
    "GitHub 尚未发布正式版本" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Official GitHub Release Yet" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 尚未發布正式版本" } } } },
    "已经是最新正式版本" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You're Up to Date" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已經是最新正式版本" } } } },
    "当前版本比最新 Release 更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This Build Is Newer Than the Latest Release" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本比最新 Release 更新" } } } },
    "暂时无法检查更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to Check for Updates" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫時無法檢查更新" } } } },
    "正在检查 GitHub 最新版本…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking GitHub for Updates…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢查 GitHub 最新版本…" } } } },
    "发现新版本 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Version %@ Is Available" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "發現新版本 %@" } } } },
    "当前版本 %@，正在读取公开的 GitHub Release。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. Reading the public GitHub Release." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@，正在讀取公開的 GitHub Release。" } } } },
    "当前版本为 %@。仓库目前没有正式 Release；维护者发布后，这里会自动参与版本比较。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. The repository has no official Release yet; future releases will be compared here automatically." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本為 %@。倉庫目前沒有正式 Release；維護者發布後，這裡會自動參與版本比較。" } } } },
    "当前版本 %@，最新正式版本 %@。CleanNest 不会自动替换 App，请前往 GitHub 核对说明后下载。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. Latest official version: %@. CleanNest never replaces the app automatically; review the release on GitHub before downloading." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@，最新正式版本 %@。CleanNest 不會自動替換 App，請前往 GitHub 核對說明後下載。" } } } },
    "当前版本 %@ 已与 GitHub 最新正式版本一致。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Version %@ matches the latest official GitHub Release." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@ 已與 GitHub 最新正式版本一致。" } } } },
    "当前版本 %@，GitHub 最新正式版本 %@。你可能正在使用开发构建。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. Latest official GitHub version: %@. You may be using a development build." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@，GitHub 最新正式版本 %@。你可能正在使用開發構建。" } } } },
    "仅在你点击检查时访问 GitHub；会发送当前 App 版本，GitHub 可看到 IP 等常规网络信息，但不会收到文件清单或扫描结果。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub is contacted only when you check. The current app version is sent, and GitHub can see normal network data such as your IP address; file lists and scan results are never sent." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅在你點擊檢查時存取 GitHub；會傳送目前 App 版本，GitHub 可看到 IP 等一般網路資訊，但不會收到檔案清單或掃描結果。" } } } },
    "从 GitHub 获取最新正式版本；不会自动安装。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checks the latest official GitHub Release; never installs automatically." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "從 GitHub 取得最新正式版本；不會自動安裝。" } } } },
    "正在读取 GitHub 最新正式 Release…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reading the latest official GitHub Release…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在讀取 GitHub 最新正式 Release…" } } } },
    "GitHub 目前尚未发布正式版本。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub has no official Release yet." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 目前尚未發布正式版本。" } } } },
    "可更新到 %@。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Version %@ is available." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可更新到 %@。" } } } },
    "当前已是最新正式版本。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You have the latest official version." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前已是最新正式版本。" } } } },
    "当前构建比最新正式版本更新。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This build is newer than the latest official version." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前構建比最新正式版本更新。" } } } },
    "开发构建" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Development Build" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開發構建" } } } },
    "当前构建没有可比较的版本号。请使用打包后的 CleanNest.app 检查更新。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This build has no comparable version. Use a packaged CleanNest.app to check for updates." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前構建沒有可比較的版本號。請使用打包後的 CleanNest.app 檢查更新。" } } } },
    "未能在浏览器中打开 CleanNest 发布页。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not open the CleanNest Releases page in your browser." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未能在瀏覽器中開啟 CleanNest 發布頁。" } } } },
    "未知" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unknown" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未知" } } } },
    "关闭" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉" } } } },
    "CleanNest 的 GitHub 更新地址无效。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The CleanNest GitHub update address is invalid." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 的 GitHub 更新地址無效。" } } } },
    "GitHub 没有返回有效的更新响应。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub did not return a valid update response." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 沒有傳回有效的更新回應。" } } } },
    "更新响应没有来自 GitHub 官方 API。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The update response did not come from the official GitHub API." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "更新回應沒有來自 GitHub 官方 API。" } } } },
    "GitHub 暂时限制了检查频率，请稍后再试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub has temporarily rate-limited update checks. Try again later." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 暫時限制了檢查頻率，請稍後再試。" } } } },
    "GitHub 更新服务暂时不可用（HTTP %d）。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub's update service is temporarily unavailable (HTTP %d)." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 更新服務暫時無法使用（HTTP %d）。" } } } },
    "GitHub 返回的数据超出允许范围。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub returned more update data than allowed." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 傳回的資料超出允許範圍。" } } } },
    "GitHub 返回了无法识别的发布信息。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub returned unrecognized release information." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 傳回了無法識別的發布資訊。" } } } },
    "GitHub 返回的不是正式公开版本。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub returned a release that is not officially published." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 傳回的不是正式公開版本。" } } } },
    "GitHub 版本标签格式无法识别：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unrecognized GitHub version tag: %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 版本標籤格式無法識別：%@" } } } },
    "GitHub 返回的下载页面不属于 CleanNest 官方仓库。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The download page returned by GitHub does not belong to the official CleanNest repository." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 傳回的下載頁面不屬於 CleanNest 官方倉庫。" } } } },
    "无法连接 GitHub，请检查网络后重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to reach GitHub. Check your network and try again." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法連線 GitHub，請檢查網路後重試。" } } } },
    "演示模式只展示更新流程，不会下载安装包或打开安装器。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Demo mode only previews the update flow. It does not download a package or open Installer." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "演示模式只展示更新流程，不會下載安裝套件或開啟安裝器。" } } } },
    "CleanNest 99.0.0 演示更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 99.0.0 Demo Update" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 99.0.0 演示更新" } } } },
    "这是用于验收更新界面的合成版本，不会访问网络，也不会下载或安装任何文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This synthetic release validates the update interface. It does not access the network or download or install any files." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這是用於驗收更新介面的合成版本，不會存取網路，也不會下載或安裝任何檔案。" } } } },
    "安装包下载被重定向到不受信任的地址，已停止下载。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The package download redirected to an untrusted address and was stopped." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝套件下載重新導向至不受信任的位址，已停止下載。" } } } },
    "无法创建 CleanNest 更新缓存目录。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not create the CleanNest update cache directory." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法建立 CleanNest 更新快取目錄。" } } } },
    "安装包未通过 CleanNest 团队的 Developer ID Installer 签名校验，已停止安装。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The package failed the CleanNest team’s Developer ID Installer signature check. Installation was stopped." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝套件未通過 CleanNest 團隊的 Developer ID Installer 簽名驗證，已停止安裝。" } } } },
    "安装包未通过 Apple 公证票据校验，已停止安装。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The package failed Apple notarization ticket validation. Installation was stopped." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝套件未通過 Apple 公證票據驗證，已停止安裝。" } } } },
    "安装包未通过 macOS Gatekeeper 评估，已停止安装。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The package failed the macOS Gatekeeper assessment. Installation was stopped." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝套件未通過 macOS Gatekeeper 評估，已停止安裝。" } } } },
    "无法打开 macOS 安装器。安装包仍保留在更新缓存中，你可以重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not open macOS Installer. The package remains in the update cache; you can retry." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法開啟 macOS 安裝器。安裝套件仍保留在更新快取中，你可以重試。" } } } },
    "GitHub Release 的安装包命名、大小或 SHA-256 摘要不符合要求，不能自动下载。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The GitHub Release package name, size, or SHA-256 digest does not meet the requirements, so automatic download is unavailable." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub Release 的安裝套件命名、大小或 SHA-256 摘要不符要求，無法自動下載。" } } } },
    "安装包下载地址不属于 CleanNest 官方 Release。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The package download address does not belong to an official CleanNest Release." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝套件下載位址不屬於 CleanNest 官方 Release。" } } } },
    "下载结果不是可读取的普通安装包文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The download is not a readable, regular installer file." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下載結果不是可讀取的普通安裝套件檔案。" } } } },
    "安装包实际大小与 GitHub Release 记录不一致，已删除下载文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The package size does not match the GitHub Release record. The downloaded file was deleted." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝套件實際大小與 GitHub Release 記錄不符，已刪除下載檔案。" } } } },
    "安装包 SHA-256 与 GitHub Release 摘要不一致，已删除下载文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The package SHA-256 does not match the GitHub Release digest. The downloaded file was deleted." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝套件 SHA-256 與 GitHub Release 摘要不符，已刪除下載檔案。" } } } },
    "更新操作已取消。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The update operation was cancelled." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "更新操作已取消。" } } } },
    "自动检查更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check for Updates Automatically" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動檢查更新" } } } },
    "App 运行期间每 24 小时检查一次；发现新版本才提醒，不会自动下载或安装。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checks every 24 hours while the app is running. Alerts only about new versions; never downloads or installs automatically." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 執行期間每 24 小時檢查一次；發現新版本才提醒，不會自動下載或安裝。" } } } },
    "自动检查可在设置中关闭。检查只读取公开 Release；只有你确认后才会下载 PKG，不会发送文件清单或扫描结果。GitHub 可看到当前 App 版本、IP 等常规网络信息。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic checks can be disabled in Settings. Checks read only public Releases; a PKG is downloaded only after your confirmation. File lists and scan results are never sent. GitHub can see normal network data such as your current app version and IP address." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動檢查可在設定中關閉。檢查只讀取公開 Release；只有你確認後才會下載 PKG，不會傳送檔案清單或掃描結果。GitHub 可看到目前 App 版本、IP 等一般網路資訊。" } } } },
    "下载并安装 CleanNest？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download and Install CleanNest?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下載並安裝 CleanNest？" } } } },
    "下载并校验" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download and Verify" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下載並驗證" } } } },
    "将从 CleanNest 官方 GitHub Release 下载 %@ 安装包，核对 SHA-256、Developer ID 签名、Apple 公证和 Gatekeeper。全部通过后仍需你点击“打开安装器”，并在 macOS 安装器中最终确认。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest will download a %@ package from the official GitHub Release and verify its SHA-256, Developer ID signature, Apple notarization, and Gatekeeper assessment. After all checks pass, you must still click Open Installer and confirm in macOS Installer." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將從 CleanNest 官方 GitHub Release 下載 %@ 安裝套件，核對 SHA-256、Developer ID 簽名、Apple 公證和 Gatekeeper。全部通過後仍需你點擊「開啟安裝器」，並在 macOS 安裝器中最終確認。" } } } },
    "官方 PKG 安装包已就绪，等待你确认下载。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The official PKG is ready and awaits your confirmation to download." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "官方 PKG 安裝套件已就緒，等待你確認下載。" } } } },
    "正在下载官方安装包（%@）…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloading the official package (%@)…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在下載官方安裝套件（%@）…" } } } },
    "正在校验 SHA-256、Developer ID 签名、Apple 公证与 Gatekeeper…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Verifying SHA-256, Developer ID signature, Apple notarization, and Gatekeeper…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在驗證 SHA-256、Developer ID 簽名、Apple 公證與 Gatekeeper…" } } } },
    "全部安全校验已通过。点击“打开安装器”后，由 macOS 安装器继续。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "All security checks passed. Click Open Installer to continue in macOS Installer." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "全部安全驗證已通過。點擊「開啟安裝器」後，由 macOS 安裝器繼續。" } } } },
    "macOS 安装器已打开。请在安装器中核对版本并完成系统确认。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS Installer is open. Review the version and complete the system confirmation in Installer." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 安裝器已開啟。請在安裝器中核對版本並完成系統確認。" } } } },
    "下载并安装…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download and Install…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下載並安裝…" } } } },
    "正在下载…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloading…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在下載…" } } } },
    "正在校验…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Verifying…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在驗證…" } } } },
    "打开安装器" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Installer" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟安裝器" } } } },
    "重新打开安装器" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reopen Installer" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新開啟安裝器" } } } },
    "当前版本 %@，最新正式版本 %@。自动检查不会下载；只有你确认后才会获取并校验安装包。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. Latest official version: %@. Automatic checks never download; the package is fetched and verified only after your confirmation." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@，最新正式版本 %@。自動檢查不會下載；只有你確認後才會取得並驗證安裝套件。" } } } },
    "当前版本 %@，最新正式版本 %@。这个 Release 没有符合要求的 PKG，请前往 GitHub 核对说明并手动下载。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. Latest official version: %@. This Release has no eligible PKG. Review the notes on GitHub and download manually." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@，最新正式版本 %@。這個 Release 沒有符合要求的 PKG，請前往 GitHub 核對說明並手動下載。" } } } },
    "发布页" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Release Page" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "發布頁" } } } },
    "本机模型尚未连接" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device Model Not Connected" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機模型尚未連線" } } } },
    "本机 AI 已关闭" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device AI Is Off" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機 AI 已關閉" } } } },
    "尚未检测本机模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device Model Not Checked" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未檢測本機模型" } } } },
    "正在检测本机模型…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking On-device Model…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢測本機模型…" } } } },
    "正在载入本机模型…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading On-device Model…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在載入本機模型…" } } } },
    "正在停止本机模型…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopping On-device Model…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在停止本機模型…" } } } },
    "普通扫描仍可继续使用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Regular scans remain available." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "一般掃描仍可繼續使用。" } } } },
    "保存设置后即可检测，无需打开终端。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save these settings to check the model—no Terminal required." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "儲存設定後即可檢測，無需開啟終端機。" } } } },
    "正在检查回环服务与所选模型。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking the loopback service and selected model." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢查回環服務與所選模型。" } } } },
    "大型模型首次载入可能需要几十秒，界面仍可继续使用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A large model may take tens of seconds to load the first time; the interface remains usable." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "大型模型首次載入可能需要數十秒，介面仍可繼續使用。" } } } },
    "正在安全结束由 CleanNest 启动的模型进程。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safely stopping the model process started by CleanNest." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在安全結束由 CleanNest 啟動的模型程序。" } } } },
    "启用本机 AI 分析" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable On-device AI Analysis" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用本機 AI 分析" } } } },
    "关闭后普通规则扫描仍可使用；只会停止由 CleanNest 自己启动的模型进程。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Regular rule-based scans remain available when off. Only model processes started by CleanNest are stopped." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉後一般規則掃描仍可使用；只會停止由 CleanNest 自行啟動的模型程序。" } } } },
    "模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Model" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "模型" } } } },
    "自启模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Self-start Model" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自啟模型" } } } },
    "选择本机模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose an On-device Model" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇本機模型" } } } },
    "请选择一个本机模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose an on-device model" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請選擇一個本機模型" } } } },
    "扫描模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan Models" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "掃描模型" } } } },
    "选择其他…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose Other…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇其他…" } } } },
    "服务地址" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Service URL" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "服務位址" } } } },
    "API 模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "API Model" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "API 模型" } } } },
    "选择服务公布的模型短名" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a model ID exposed by the service" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇服務公布的模型短名" } } } },
    "自动（服务默认：%@）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic (service default: %@)" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動（服務預設：%@）" } } } },
    "自动（读取服务默认模型）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic (use service default)" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動（讀取服務預設模型）" } } } },
    "%@ · DFlash 加速草稿（不要直接选择）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ · DFlash acceleration draft (do not select directly)" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ · DFlash 加速草稿（請勿直接選擇）" } } } },
    "oMLX 调用必须使用 /v1/models 返回的短名；下方目录只用于 CleanNest 自己启动 mlx_lm.server。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "oMLX calls must use an ID returned by /v1/models. The folder below is only for mlx_lm.server started by CleanNest." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "oMLX 呼叫必須使用 /v1/models 回傳的短名；下方目錄只供 CleanNest 自行啟動 mlx_lm.server。" } } } },
    "目录路径" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Folder Path" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目錄路徑" } } } },
    "模型目录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Model Folder" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "模型目錄" } } } },
    "运行程序" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Executable" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "執行程式" } } } },
    "本机 MLX 模型目录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local MLX model folder" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機 MLX 模型目錄" } } } },
    "mlx_lm.server 可执行文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "mlx_lm.server executable" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "mlx_lm.server 執行檔" } } } },
    "只发送名称、脱敏路径、大小、类型、时间和扫描说明；不读取文件内容，AI 也不能勾选或删除。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only names, redacted paths, sizes, types, dates, and scan context are sent. File contents are not read, and AI cannot select or delete items." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只傳送名稱、去識別路徑、大小、類型、時間與掃描說明；不讀取檔案內容，AI 也不能勾選或刪除。" } } } },
    "诊断详情" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Diagnostic Details" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "診斷詳情" } } } },
