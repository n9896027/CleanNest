    "每 60 秒记录 CPU、内存、磁盘、电池与温度；使用 SQLite WAL，只保存在这台 Mac。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Records CPU, memory, disk, battery, and temperature every 60 seconds using SQLite WAL. Data stays on this Mac." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每 60 秒記錄 CPU、記憶體、磁碟、電池與溫度；使用 SQLite WAL，只保存在這台 Mac。" } } } },
    "保留期限" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Retention" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "保留期限" } } } },
    "删除历史指标" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete Metric History" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除歷史指標" } } } },
    "只读 MCP" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only MCP" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀 MCP" } } } },
    "把 CleanNest 的本机证据交给你的 AI 客户端读取" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Let your AI client read CleanNest evidence" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "讓你的 AI 客戶端讀取 CleanNest 本機證據" } } } },
    "仅通过本机标准输入/输出运行；没有 HTTP 端口，没有删除、结束进程或修改设置的工具。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Runs only over local standard input/output. No HTTP port and no tools for deletion, process termination, or settings changes." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅透過本機標準輸入／輸出執行；沒有 HTTP 連接埠，也沒有刪除、結束程序或修改設定的工具。" } } } },
    "只读" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀" } } } },
    "复制路径" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy Path" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "複製路徑" } } } },
