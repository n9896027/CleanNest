    "明确选择清理或保留" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose clean or keep explicitly" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "明確選擇清理或保留" } } } },
    "只记录偏好与理由" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Store only the preference and reason" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只記錄偏好與理由" } } } },
