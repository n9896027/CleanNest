{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "本机工作台" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device Workspace" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機工作台" } } } },
    "只读容量快照" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only capacity snapshot" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀容量快照" } } } },
    "选择一个明确任务，CleanNest 不会替你自动删除" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a clear task. CleanNest never deletes on your behalf." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇一個明確任務，CleanNest 不會替你自動刪除" } } } },
    "当前模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current Model" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前模型" } } } },
    "本机模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device Model" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機模型" } } } },
    "本地模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local Models" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本地模型" } } } },
    "看清模型、监听地址与自动拉起来源；外部服务可连同精确 launchd 守护一起安全停用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "See the model, listener, and auto-launch source. External services can be safely disabled together with the exact launchd job." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "看清模型、偵聽位址與自動拉起來源；外部服務可連同精確 launchd 守護一起安全停用。" } } } },
    "只检查本机进程、监听端口、平台健康 API 与 launchd 配置元数据；不扫描局域网、不发送提示词、不保存内网地址，也不读取环境变量。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checks only local processes, listeners, platform health APIs, and launchd configuration metadata. It does not scan your LAN, send prompts, save private-network addresses, or read environment variables." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只檢查本機處理程序、偵聽連接埠、平台健康 API 與 launchd 設定中繼資料；不掃描區域網路、不傳送提示詞、不儲存內網位址，也不讀取環境變數。" } } } },
    "停用守护并关闭…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disable Supervisor and Close…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "停用守護並關閉…" } } } },
    "已发现自动拉起来源；停用后可在本页重新启用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "An auto-launch source was found. You can re-enable it from this page later." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已發現自動拉起來源；停用後可在本頁重新啟用。" } } } },
    "重新启用守护" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Re-enable Supervisor" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新啟用守護" } } } },
    "重新允许 launchd 启动这个模型服务。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow launchd to start this model service again." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新允許 launchd 啟動這個模型服務。" } } } },
    "守护" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Supervisor" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "守護" } } } },
    "守护已停用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Supervisor Disabled" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "守護已停用" } } } },
    "launchd 守护" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "launchd Supervisor" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "launchd 守護" } } } },
    "停用守护…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disable Supervisor…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "停用守護…" } } } },
    "管理守护…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage Supervisor…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "管理守護…" } } } },
    "管理自动重启…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage Auto-restart…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "管理自動重新啟動…" } } } },
    "重新启用守护…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Re-enable Supervisor…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新啟用守護…" } } } },
    "打开运行中心，查看自动重启风险并停用精确守护服务" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Runtime Center to review auto-restart risks and disable the exact supervisor" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟執行中心，查看自動重新啟動風險並停用精確守護服務" } } } },
    "重新启用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Re-enable" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新啟用" } } } },
    "自动拉起来源" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto-launch Source" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動拉起來源" } } } },
    "守护配置" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Supervisor Configuration" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "守護設定" } } } },
    "路径未确认" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Path Unverified" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "路徑未確認" } } } },
    "守护服务已停用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Supervisor Disabled" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "守護服務已停用" } } } },
    "检测到自动重启来源" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto-restart Source Detected" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "偵測到自動重新啟動來源" } } } },
    "%@ 当前被 launchd 禁用；配置文件仍保留，可从这里重新启用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ is currently disabled in launchd. Its configuration remains and can be re-enabled here." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ 目前已被 launchd 停用；設定檔仍保留，可從這裡重新啟用。" } } } },
    "%@ · %@。只结束 PID 可能马上出现新进程。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ · %@. Ending only the PID may immediately produce a new process." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ · %@。只結束 PID 可能馬上出現新處理程序。" } } } },
    "五类本地运行时共享同一套证据门；除进程与 API 外，还会识别 launchd 守护、自动重启和登录启动状态。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Five local runtimes share the same evidence gate, including launchd supervisors, auto-restart behavior, and login launch state in addition to processes and APIs." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "五類本地運行環境共用同一套證據門；除處理程序與 API 外，還會識別 launchd 守護、自動重新啟動與登入啟動狀態。" } } } },
    "我确认要停用这个守护服务，直到我在 CleanNest 中重新启用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I understand this supervisor will remain disabled until I re-enable it in CleanNest." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "我確認要停用這個守護服務，直到我在 CleanNest 中重新啟用。" } } } },
    "正在停用守护并关闭…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disabling Supervisor and Closing…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在停用守護並關閉…" } } } },
    "停用 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disable %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "停用 %@" } } } },
    "停用守护并关闭？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disable Supervisor and Close?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "停用守護並關閉？" } } } },
    "launchd 正在自动拉起这个服务。停用精确守护标签后再关闭，才不会瞬间重启。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "launchd is automatically relaunching this service. Disable the exact supervisor label before closing it to prevent an immediate restart." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "launchd 正在自動拉起這個服務。停用精確守護標籤後再關閉，才不會瞬間重新啟動。" } } } },
    "阻止重启" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Prevent Restart" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "阻止重新啟動" } } } },
    "守护标签" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Supervisor Label" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "守護標籤" } } } },
    "%@ 将被标记为停用，重新登录后也不会自动启动，直到你主动重新启用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ will be disabled and will not start after login until you explicitly re-enable it." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ 將被標記為停用，重新登入後也不會自動啟動，直到你主動重新啟用。" } } } },
    "%@ 设置了 %@；只关 PID 后很可能立刻以新 PID 返回。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ uses %@. Closing only its PID will likely make it return immediately with a new PID." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ 設定了 %@；只關 PID 後很可能立刻以新 PID 返回。" } } } },
    "CleanNest 会复核 PID、守护标签、作用域与配置文件身份，只对这个用户 LaunchAgent 执行 disable 与 bootout；不会编辑或删除 plist，也不会影响其他守护服务。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest rechecks the PID, supervisor label, domain, and configuration identity, then runs disable and bootout only for this user LaunchAgent. It does not edit or delete the plist or affect other supervisors." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 會複核 PID、守護標籤、作用域與設定檔身分，只對這個使用者 LaunchAgent 執行 disable 與 bootout；不會編輯或刪除 plist，也不會影響其他守護服務。" } } } },
    "KeepAlive · 登录时启动" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "KeepAlive · Starts at Login" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "KeepAlive · 登入時啟動" } } } },
    "KeepAlive 会自动重启" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "KeepAlive Auto-restarts" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "KeepAlive 會自動重新啟動" } } } },
    "登录时自动启动" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Starts at Login" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "登入時自動啟動" } } } },
    "由 launchd 管理" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Managed by launchd" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "由 launchd 管理" } } } },
    "已安装但未载入" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installed but Not Loaded" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已安裝但未載入" } } } },
    "看清这台 Mac 正在运行什么模型、由谁启动、监听在哪里；自有服务直接停止，外部服务经风险确认后精确关闭。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "See which models are running, who started them, and where they listen. Stop owned services directly; close external services only after a risk review." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "看清這台 Mac 正在運行什麼模型、由誰啟動、偵聽在哪裡；自有服務直接停止，外部服務經風險確認後精確關閉。" } } } },
    "关闭外部服务…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close External Service…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉外部服務…" } } } },
    "关闭…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉…" } } } },
    "先显示风险并复核精确 PID，再发送正常退出。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review risks and verify the exact PID before requesting a normal exit." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "先顯示風險並複核精確 PID，再傳送正常退出。" } } } },
    "身份不足 · 只读" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Insufficient Identity · Read-only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "身分不足 · 唯讀" } } } },
    "缺少可防止 PID 复用的身份依据，暂不提供关闭。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Identity evidence is insufficient to prevent PID reuse, so closing is unavailable." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "缺少可防止 PID 重複使用的身分依據，暫不提供關閉。" } } } },
    "外部服务关闭需要处理" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "External Service Needs Attention" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "外部服務關閉需要處理" } } } },
    "外部服务状态已更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "External Service Status Updated" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "外部服務狀態已更新" } } } },
    "关闭提示" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dismiss" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉提示" } } } },
    "进一步强制结束…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Force Quit…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "進一步強制結束…" } } } },
    "关闭外部模型服务？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close External Model Service?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉外部模型服務？" } } } },
    "进一步强制结束？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Force Quit This Process?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "進一步強制結束？" } } } },
    "这是其他 App 或命令启动的服务。先确认影响，再关闭这个精确进程。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Another app or command started this service. Review the impact before closing this exact process." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這是其他 App 或命令啟動的服務。先確認影響，再關閉這個精確處理程序。" } } } },
    "正常退出没有完成。强制结束是最后手段，需要再次确认。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Normal termination did not complete. Force quit is a last resort and requires another confirmation." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正常退出沒有完成。強制結束是最後手段，需要再次確認。" } } } },
    "需确认" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirmation Required" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需確認" } } } },
    "高风险" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "High Risk" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "高風險" } } } },
    "即将操作的真实对象" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Exact Target" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "即將操作的真實對象" } } } },
    "平台" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Platform" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "平台" } } } },
    "可执行文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Executable" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可執行檔" } } } },
    "风险分析" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Risk Analysis" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "風險分析" } } } },
    "正在生成的回答会被中断，连接这个服务的客户端可能收到错误。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Active generations will be interrupted, and connected clients may receive errors." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在生成的回答會被中斷，連線到此服務的用戶端可能收到錯誤。" } } } },
    "局域网设备也可能正在使用这个地址；它们的连接会同时断开。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Devices on your LAN may be using this address; their connections will also be interrupted." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "區域網路裝置也可能正在使用這個位址；它們的連線會同時中斷。" } } } },
    "该 PID 可能属于 LM Studio 主程序；关闭服务也可能退出它的窗口。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This PID may belong to the main LM Studio app; closing the service may also quit its window." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此 PID 可能屬於 LM Studio 主程式；關閉服務也可能退出其視窗。" } } } },
    "如果服务由登录项、launchd 或平台守护程序管理，它可能以新 PID 自动重启。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A login item, launchd, or platform supervisor may automatically restart the service with a new PID." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "若服務由登入項目、launchd 或平台守護程式管理，可能會以新 PID 自動重新啟動。" } } } },
    "强制结束不会给进程保存缓冲区或释放任务的时间。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Force quit gives the process no time to save buffers or release work." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "強制結束不會給處理程序保存緩衝區或釋放工作的時間。" } } } },
    "CleanNest 会再次核对 PID、启动时间、用户与可执行文件，只发送正常退出 SIGTERM；不会按名称批量结束，也不会删除模型或配置。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest rechecks the PID, start time, user, and executable, then sends SIGTERM only to that verified process. It never kills by name or deletes models or settings." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 會再次核對 PID、啟動時間、使用者與可執行檔，只向複核通過的處理程序傳送 SIGTERM；不會按名稱批次結束，也不會刪除模型或設定。" } } } },
    "CleanNest 会再次核对 PID、启动时间、用户与可执行文件，只向复核通过的进程发送 SIGKILL；不会删除模型、配置或日志。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest rechecks the PID, start time, user, and executable, then sends SIGKILL only to that verified process. It does not delete models, settings, or logs." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 會再次核對 PID、啟動時間、使用者與可執行檔，只向複核通過的處理程序傳送 SIGKILL；不會刪除模型、設定或記錄。" } } } },
    "我确认该进程可能来不及保存状态，仍要强制结束。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I understand this process may not save its state and still want to force quit." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "我確認此處理程序可能來不及保存狀態，仍要強制結束。" } } } },
    "正在正常关闭…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Closing Normally…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在正常關閉…" } } } },
    "正在强制结束…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Force Quitting…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在強制結束…" } } } },
    "正常关闭 PID %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close PID %@ Normally" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正常關閉 PID %@" } } } },
    "强制结束 PID %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Force Quit PID %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "強制結束 PID %@" } } } },
    "管理/关闭…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage/Close…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "管理/關閉…" } } } },
    "管理外部服务…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage External Service…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "管理外部服務…" } } } },
    "菜单栏状态" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Menu Bar Status" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選單列狀態" } } } },
    "重新发现" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Discover Again" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新偵測" } } } },
    "只确认到运行迹象" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Runtime Evidence Only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只確認到運行跡象" } } } },
    "进程或端口存在，但模型 API 尚未返回可用短 ID。CleanNest 不会把它误报为健康。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A process or port exists, but the model API has not returned a usable short ID. CleanNest will not report it as healthy." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "處理程序或連接埠存在，但模型 API 尚未回傳可用短 ID。CleanNest 不會將它誤報為健康。" } } } },
    "重新检查" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check Again" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新檢查" } } } },
