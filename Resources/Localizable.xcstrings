    "系统状态为只读采样" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System status is read-only sampling" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "系統狀態為唯讀採樣" } } } },
