    "不会自动删除" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Never Deletes Automatically" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不會自動刪除" } } } },
