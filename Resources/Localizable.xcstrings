    "%d 项偏好" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d preferences" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 項偏好" } } } },
    "%d 次" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d times" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 次" } } } },
