{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "查找功能" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Find a Feature"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尋找功能"}}}},
    "搜索功能" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search features"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"搜尋功能"}}}},
    "例如：重复文件、模型、权限、温度…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"For example: duplicates, models, permissions, temperature…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"例如：重複檔案、模型、權限、溫度…"}}}},
    "没有找到相关功能" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No matching feature found"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"找不到相關功能"}}}},
    "换个关键词，或清空搜索查看全部功能。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try another term, or clear the search to see every feature."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"換個關鍵字，或清空搜尋以查看全部功能。"}}}},
    "显示全部功能" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Show All Features"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示全部功能"}}}},
    "回车打开第一个结果 · 这里只导航，不执行清理或启停操作" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Press Return to open the first result · This only navigates; it does not clean, start, or stop anything."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"按 Return 開啟第一個結果 · 此處只導覽，不會清理或啟停任何項目。"}}}},
    "查找功能（⌘K）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Find a Feature (⌘K)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尋找功能（⌘K）"}}}},
    "智能工具" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Smart Tools"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"智慧工具"}}}},
    "Mac 当前状态和常用操作" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current Mac status and common actions"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前 Mac 狀態與常用操作"}}}},
    "缓存、安装包、截图、媒体和重复文件" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Caches, installers, screenshots, media, and duplicates"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"快取、安裝套件、截圖、媒體與重複檔案"}}}},
    "查找 App 并预览卸载内容" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Find apps and preview uninstall contents"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尋找 App 並預覽解除安裝內容"}}}},
    "大文件、空间分布和系统数据占用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Large files, storage distribution, and system-data usage"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"大型檔案、空間分布與系統資料佔用"}}}},
    "实时监测、内存进程、趋势和告警" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Live monitoring, memory processes, trends, and alerts"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"即時監測、記憶體程序、趨勢與警示"}}}},
    "诊断与修复预览、Dock 或 Finder 异常" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagnostics and repair previews for Dock or Finder issues"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Dock 或 Finder 問題的診斷與修復預覽"}}}},
    "查看编程助手占用、清理计划和恢复包" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review coding-agent storage, cleanup plans, and recovery packages"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢視程式助手佔用、清理計畫與復原套件"}}}},
    "发现、启停模型服务并查看守护进程" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discover, start or stop model services, and inspect daemons"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"探索、啟停模型服務並檢視守護程序"}}}},
    "管理保留偏好与待确认建议" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage retention preferences and pending suggestions"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"管理保留偏好與待確認建議"}}}},
    "操作结果、累计统计和失败详情" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Operation results, cumulative totals, and failure details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"操作結果、累計統計與失敗詳情"}}}},
    "连接、扫描范围、语言与应用设置" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connections, scan scope, language, and app settings"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連線、掃描範圍、語言與 App 設定"}}}},
    "文件访问与扫描范围" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"File Access and Scan Scope"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檔案存取與掃描範圍"}}}},
    "菜单栏与告警" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Menu Bar and Alerts"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選單列與警示"}}}},
    "AI 连接设置" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI Connection Settings"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"AI 連線設定"}}}},
    "历史与存储设置" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"History and Storage Settings"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史與儲存設定"}}}},
    "关于与更新" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About and Updates"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關於與更新"}}}},
    "已展开" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expanded"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已展開"}}}},
    "已折叠" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Collapsed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已摺疊"}}}},
    "展开详情" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expand details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"展開詳情"}}}},
    "收起详情" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Collapse details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"收起詳情"}}}},
    "先看占用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Storage at a Glance"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先看佔用"}}}},
    "运行关系" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runtime Relationships"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"執行關係"}}}},
    "只显示已证实的进程、端口和模型连接" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only verified processes, ports, and model connections are shown"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只顯示已驗證的程序、連接埠與模型連線"}}}},
    "其他扫描说明" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other Scan Notes"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"其他掃描說明"}}}},
    "恢复记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recovery History"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"復原記錄"}}}},
    "备份仅留在这台 Mac；恢复不会覆盖新文件" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Backups stay on this Mac only; recovery never overwrites newer files"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"備份只留在此 Mac；復原不會覆寫新檔案"}}}},
    "选择范围" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose Scope"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇範圍"}}}},
    "收起范围" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hide Scope"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"收起範圍"}}}},
    "默认不选；先选范围，再看清理计划。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing is selected by default. Choose a scope, then review the cleanup plan."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"預設不選取；先選範圍，再查看清理計畫。"}}}},
    "按分类选择；随时可展开取消单个文件。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select by category; expand any category to deselect individual files."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"按分類選取；隨時可展開取消個別檔案。"}}}},
    "会先压缩校验；完成后再显示实际可用空间变化。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Files are archived and verified first; actual available-space changes are shown only after completion."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"會先壓縮並驗證；完成後才顯示實際可用空間變化。"}}}},
    "连接与运行关系" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connections and Runtime Relationships"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連線與執行關係"}}}},
    "进程、地址、客户端和守护来源" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Processes, addresses, clients, and daemon sources"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"程序、位址、用戶端與守護來源"}}}},
    "测试与记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tests and History"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測試與記錄"}}}},
    "支持的平台与隐私范围" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Supported Platforms and Privacy Scope"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"支援的平台與隱私範圍"}}}},
    "只读发现；不扫描局域网或读取环境变量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read-only discovery; no LAN scan or environment-variable access"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"唯讀探索；不掃描區域網路或讀取環境變數"}}}},
    "为什么这样判断" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Why This Status"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"為何這樣判斷"}}}},
    "服务详情" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Service Details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"服務詳情"}}}},
    "这个模型服务可能被局域网访问" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This model service may be reachable on the local network"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此模型服務可能可從區域網路存取"}}}},
    "它没有只监听本机回环地址。CleanNest 不会自动改防火墙；详情可查看确认到的地址。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"It is not listening only on this Mac’s loopback address. CleanNest will not change the firewall automatically; see details for confirmed addresses."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"它不只監聽此 Mac 的回環位址。CleanNest 不會自動修改防火牆；詳情可查看已確認的位址。"}}}},
    "停止后可能会自动重启" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"It May Restart After Stopping"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"停止後可能會自動重新啟動"}}}},
    "TCP 实测" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"TCP verified"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"TCP 實測"}}}},
    "查看证据" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"View Evidence"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看證據"}}}},
    "收起证据" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hide Evidence"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"收起證據"}}}},
    "尚待验证" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Awaiting verification"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚待驗證"}}}},
    "未发现运行证据" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No runtime evidence found"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未發現執行證據"}}}},
    "已连接本地模型" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connected to a local model"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已連線至本機模型"}}}},
    "运行中 · 未观察到模型连接" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Running · no model connection observed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"執行中 · 未觀察到模型連線"}}}},
    "可测速；本次没有启停记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ready to benchmark; no start or stop events this session"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可測速；本次沒有啟停記錄"}}}},
    "%@ 正由 launchd 管理。仅结束进程可能立刻重新出现；要停用会先要求确认守护来源。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is managed by launchd. Ending only the process may make it reappear immediately; disabling it requires confirmation of the daemon source first."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 正由 launchd 管理。只結束程序可能會立刻重新出現；停用前會先要求確認守護來源。"}}}},
    "查看正在运行的模型，管理服务启停。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"See running models and manage service start and stop."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看正在執行的模型，管理服務啟停。"}}}},
    "查看开发工具的占用和清理预览。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review developer-tool storage and cleanup previews."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看開發工具佔用與清理預覽。"}}}},
    "查看各类文件，选择范围后再预览处理。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review file categories, choose a scope, then preview the action."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看各類檔案，選擇範圍後再預覽處理。"}}}},
    "看看编程助手留下了什么，哪些仍在使用。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"See what coding assistants left behind and what is still in use."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"看看程式助手留下了什麼，哪些仍在使用。"}}}},
    "记住你想保留什么，下次少做重复判断。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remember what you want to keep, so there is less repeat decision-making next time."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"記住你想保留什麼，下次少做重複判斷。"}}}},
    "查找做过的操作，查看结果与恢复方式。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Find past actions and review results and recovery options."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查找做過的操作，查看結果與復原方式。"}}}},
    "系统数据占用清单" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System Data Storage Inventory"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"系統資料佔用清單"}}}},
    "缓存、模型、虚拟机与备份" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Caches, models, virtual machines, and backups"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"快取、模型、虛擬機與備份"}}}},
    "扫描方式与索引" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Method and Index"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃描方式與索引"}}}},
    "普通扫描可复用可靠结果；深度刷新可随时取消" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Standard scans can reuse reliable results; deep refresh can be cancelled at any time"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一般掃描可重用可靠結果；深度重新整理可隨時取消"}}}},
    "返回 App 列表" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back to App List"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"返回 App 列表"}}}},
    "App 私有" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App-private"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"App 私有"}}}},
    "复核并移到废纸篓…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify and Move to Trash…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"複核並移至垃圾桶…"}}}},
    "本次扫描详情" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Scan: Details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本次掃描詳情"}}}},
    "扫描选项" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Options"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃描選項"}}}},
    "安全与验证信息" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Safety and Verification"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安全與驗證資訊"}}}},
    "恢复与边界" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recovery and Boundaries"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"復原與界限"}}}},
    "安全处理已开启" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Safe Handling Is On"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安全處理已開啟"}}}},
    "本机 AI 分析未完成" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local AI Analysis Did Not Finish"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機 AI 分析未完成"}}}},
    "检查媒体与重复文件" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check Media and Duplicates"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查媒體與重複檔案"}}}},
    "检查应用缓存" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check App Caches"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查 App 快取"}}}},
    "连接状态" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection Status"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連線狀態"}}}},
    "系统状态分栏" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System Status Sections"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"系統狀態分欄"}}}},
    "有持续异常" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"An Issue Is Ongoing"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"有持續異常"}}}},
    "查看告警" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"View Alert"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看警示"}}}},
    "维护会做什么？" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What Will Maintenance Do?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"維護會做什麼？"}}}},
    "系统数据去了哪儿？" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What's taking up system-data space?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"系統資料去哪裡了？"}}}},
    "查看占用清单" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"View storage inventory"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢視佔用清單"}}}},
    "先看用途和处理影响，再决定下一步。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Understand its purpose and removal consequences before deciding."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先看用途和處理影響，再決定下一步。"}}}},
    "按用途解释开发缓存、模型、虚拟机和设备备份，查看处理影响。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Understand developer caches, models, virtual machines, and device backups before changing anything."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"按用途解釋開發快取、模型、虛擬機和裝置備份，檢視處理影響。"}}}},
    "搜索软件、用途或路径" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search app, purpose, or path"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"搜尋軟體、用途或路徑"}}}},
    "需保留 / 工具管理" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep / Tool-managed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需保留／工具管理"}}}},
    "扫描缺口" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Coverage gaps"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃描缺口"}}}},
    "已解释的占用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Explained allocation"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已解釋的佔用"}}}},
    "磁盘实际可用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Actual available space"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"磁碟實際可用"}}}},
    "查看里面的大项" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Inspect large items inside"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢視裡面的大項"}}}},
    "去清理空间复核" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review in Cleanup"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"前往清理空間複核"}}}},
    "去 Agent 工作区" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Agent Workspace"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"前往 Agent 工作區"}}}},
    "去本地模型管理" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage local models"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"前往本機模型管理"}}}},
    "查看访问权限" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review file access"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢視存取權限"}}}},
    "此位置尚未检查，也尚未确认是否存在；请先完成现有访问检测。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This location has not been checked; its existence is unknown. Complete the access test first."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此位置尚未檢查，也尚未確認是否存在；請先完成既有存取檢測。"}}}},
    "Agent 工作区" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Agent Workspace" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Agent 工作區" } } } },
    "占用账本 · 只在本机" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Storage ledger · On this Mac only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "佔用帳本 · 僅在本機" } } } },
    "看清 Codex 与 Claude 留下的会话、缓存、运行时与异常增长；只读元数据，不读会话正文。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "See the sessions, caches, runtimes, and abnormal growth left by Codex and Claude. CleanNest reads metadata only, never conversation content." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "看清 Codex 與 Claude 留下的會話、快取、執行時與異常增長；僅讀取後設資料，不讀會話正文。" } } } },
    "只读监测" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only monitoring" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀監測" } } } },
    "正在采样" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sampling" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在採樣" } } } },
    "把可重建缓存、桌面/下载安装包、个人媒体与重复副本分开判断。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Evaluate rebuildable caches, installers from Desktop and Downloads, personal media, and duplicate copies separately." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "把可重建快取、桌面／下載安裝套件、個人媒體與重複副本分開判斷。" } } } },
    "当前显示 %d–%d / %d 项。为避免大型列表卡住，每页最多加载 %d 项。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Showing %d–%d of %d items. To keep large lists responsive, each page loads at most %d items." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前顯示 %d–%d / %d 項。為避免大型清單卡住，每頁最多載入 %d 項。" } } } },
    "上一页" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Previous Page" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "上一頁" } } } },
    "第 %d / %d 页" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Page %d of %d" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "第 %d / %d 頁" } } } },
    "下一页" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Next Page" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下一頁" } } } },
    "安装介质需要处理" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installer Media Needs Attention" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝媒體需要處理" } } } },
    "安装介质已更新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installer Media Updated" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝媒體已更新" } } } },
    "CleanNest 会检查缓存、桌面/下载安装包、已挂载安装介质和大型媒体；启用媒体分析时还会用本机 SHA-256 查找字节完全相同的副本。扫描不会改动文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest checks caches, installers on Desktop and in Downloads, mounted installer media, and large media. When media analysis is enabled, it also uses local SHA-256 to find byte-identical copies. Scanning never changes files." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 會檢查快取、桌面／下載安裝套件、已掛載安裝媒體和大型媒體；啟用媒體分析時也會用本機 SHA-256 尋找位元組完全相同的副本。掃描不會變更檔案。" } } } },
    "推出“%@”？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Eject “%@”?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "推出「%@」？" } } } },
    "推出安装介质？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Eject Installer Media?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "推出安裝媒體？" } } } },
    "安全推出" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Eject Safely" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安全推出" } } } },
    "只会卸载当前磁盘映像，不会删除或移动原始安装包。请先关闭从该卷打开的安装程序。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This only unmounts the current disk image. It does not delete or move the original installer. Close any installer opened from this volume first." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只會卸載目前磁碟映像，不會刪除或移動原始安裝套件。請先關閉從該卷宗開啟的安裝程式。" } } } },
    "原始安装包路径已不存在。推出后桌面图标会消失；若要再次打开，需要重新下载安装包。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The original installer path no longer exists. The desktop icon will disappear after ejection; download the installer again to reopen it." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "原始安裝套件路徑已不存在。推出後桌面圖示會消失；若要再次開啟，需要重新下載安裝套件。" } } } },
    "安装包与归档" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installers and Archives" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝套件與封存檔" } } } },
    "桌面/下载：%d 个安装包 · %d 个归档" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Desktop/Downloads: %d installers · %d archives" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "桌面／下載：%d 個安裝套件 · %d 個封存檔" } } } },
    "已挂载安装介质" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mounted Installer Media" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已掛載安裝媒體" } } } },
    "与可删除的安装包分开管理；不会把 /Volumes 内容加入清理清单。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Managed separately from removable installer files; content under /Volumes is never added to the cleanup list." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "與可刪除的安裝套件分開管理；不會把 /Volumes 內容加入清理清單。" } } } },
    "%d 个" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 個" } } } },
    "原始包仍在" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Source Available" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "原始套件仍在" } } } },
    "仅剩挂载卷" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mounted Copy Only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅剩掛載卷宗" } } } },
    "推出…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Eject…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "推出…" } } } },
    "不删除原始安装包，只安全卸载当前磁盘映像" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safely unmounts the current disk image without deleting the original installer" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不刪除原始安裝套件，只安全卸載目前磁碟映像" } } } },
    "原始安装包：%@；推出不会删除它。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Original installer: %@. Ejecting does not delete it." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "原始安裝套件：%@；推出不會刪除它。" } } } },
    "原始路径已不存在：%@；推出后需重新下载才能再打开。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Original path no longer exists: %@. Download it again after ejection to reopen it." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "原始路徑已不存在：%@；推出後需重新下載才能再次開啟。" } } } },
    "已完成文件扫描，但没有读到已挂载的安装介质：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "File scanning completed, but mounted installer media could not be read: %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已完成檔案掃描，但沒有讀到已掛載的安裝媒體：%@" } } } },
    "正在安全推出 %@…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safely ejecting %@…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在安全推出 %@…" } } } },
    "挂载卷已经消失或身份发生变化，CleanNest 没有发送推出命令。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The mounted volume disappeared or its identity changed. CleanNest did not send an eject command." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "掛載卷宗已消失或身分發生變化，CleanNest 沒有傳送推出指令。" } } } },
    "安装介质状态已变化" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installer Media Changed" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝媒體狀態已變更" } } } },
    "安全校验未通过：目标不是 /Volumes 下的当前用户磁盘映像。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safety validation failed: the target is not a disk image for the current user under /Volumes." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安全驗證未通過：目標不是 /Volumes 下目前使用者的磁碟映像。" } } } },
    "没有推出安装介质" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installer Media Was Not Ejected" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "沒有推出安裝媒體" } } } },
    "系统没有接受推出请求，可能仍有安装程序正在使用该卷。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS did not accept the eject request. An installer may still be using this volume." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "系統沒有接受推出要求，可能仍有安裝程式正在使用該卷宗。" } } } },
    "未能推出：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not eject: %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未能推出：%@" } } } },
    "未能推出安装介质" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could Not Eject Installer Media" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未能推出安裝媒體" } } } },
    "系统返回成功，但该挂载卷仍然存在；请重新扫描后再试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS reported success, but the mounted volume still exists. Scan again before retrying." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "系統回報成功，但該掛載卷宗仍然存在；請重新掃描後再試。" } } } },
    "安装介质仍然存在" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installer Media Is Still Mounted" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝媒體仍然存在" } } } },
    "已安全推出“%@”；没有删除或移动任何文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safely ejected “%@”. No files were deleted or moved." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已安全推出「%@」；沒有刪除或移動任何檔案。" } } } },
    "已安全推出 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safely Ejected %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已安全推出 %@" } } } },
    "没有推出“%@”：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not eject “%@”: %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "沒有推出「%@」：%@" } } } },
    "内存压力警告" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Memory Pressure Warning" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "記憶體壓力警告" } } } },
    "内存压力严重" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Critical Memory Pressure" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "記憶體壓力嚴重" } } } },
    "温度偏高" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Elevated Temperature" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "溫度偏高" } } } },
    "温度过高" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Critical Temperature" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "溫度過高" } } } },
    "磁盘空间紧张" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disk Space Is Low" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟空間吃緊" } } } },
    "磁盘空间严重不足" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disk Space Is Critically Low" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟空間嚴重不足" } } } },
    "风扇高速散热" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "High Fan Cooling" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "風扇高速散熱" } } } },
    "高温与风扇高负载" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "High Temperature and Fan Load" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "高溫與風扇高負載" } } } },
    "电量较低" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Low Battery" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "電量偏低" } } } },
    "电量严重不足" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Critically Low Battery" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "電量嚴重不足" } } } },
    "macOS 热状态：需要留意" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS thermal state: elevated" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 熱狀態：需要留意" } } } },
    "macOS 热状态：严重" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS thermal state: serious" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 熱狀態：嚴重" } } } },
    "macOS 热状态：临界" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS thermal state: critical" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 熱狀態：臨界" } } } },
    "异常状态会自动高亮" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Health Alerts Highlight Automatically" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "異常狀態會自動醒目顯示" } } } },
    "橙色与 ! 表示需要留意，红色与 !! 表示严重。判定结合 macOS 热状态、CPU/电池温度、内存压力、磁盘容量、低电量和风扇相对转速；CPU、GPU 或网络繁忙本身不会被当成故障。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Orange with ! means attention; red with !! means critical. CleanNest combines macOS thermal state, CPU and battery temperature, memory pressure, disk capacity, low battery, and relative fan speed. Busy CPU, GPU, or network activity alone is not treated as a fault." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "橙色與 ! 表示需要留意，紅色與 !! 表示嚴重。判定結合 macOS 熱狀態、CPU／電池溫度、記憶體壓力、磁碟容量、低電量和風扇相對轉速；CPU、GPU 或網路忙碌本身不會被視為故障。" } } } },
    "仅修改 %@ 分组的勾选，不会立即移动文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes only the selection in %@; files are not moved yet" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只會修改 %@ 分組的勾選，不會立即移動檔案" } } } },
    "全选截图" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select Screenshots" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "全選截圖" } } } },
    "全选本组" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select Group" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "全選本組" } } } },
    "取消全选" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Deselect All" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "取消全選" } } } },
    "图片 %d（截图 %d）· 视频 %d · 音频 %d" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d images (%d screenshots) · %d videos · %d audio" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "圖片 %d（截圖 %d）· 影片 %d · 音訊 %d" } } } },
    "截图" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screenshots" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "截圖" } } } },
    "截图 · 可批量选择" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screenshot · Batch Select" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "截圖 · 可批次選擇" } } } },
    "截图按 ScreenShot、Screenshot、Screen Shot、ScreenCapture、截屏或截图等文件名直接识别，不受大图和时间门槛限制；其他媒体仍要求至少 14 天未修改，图片 ≥ 5 MB、视频 ≥ 100 MB、音频 ≥ 20 MB。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ScreenShot, Screenshot, Screen Shot, ScreenCapture, and common Chinese screenshot names are detected directly without image-size or age thresholds. Other media must still be unchanged for 14 days and meet the 5 MB image, 100 MB video, or 20 MB audio threshold." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "ScreenShot、Screenshot、Screen Shot、ScreenCapture、截屏或截圖等檔名會直接識別，不受大型圖片與時間門檻限制；其他媒體仍須至少 14 天未修改，圖片 ≥ 5 MB、影片 ≥ 100 MB、音訊 ≥ 20 MB。" } } } },
    "%d 项本机任务" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d local tasks" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 項本機任務" } } } },
    "Dock 与启动台会短暂消失，macOS 随后自动重启 Dock。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Dock and Launchpad briefly disappear, then macOS restarts the Dock." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Dock 與啟動台會短暫消失，macOS 隨後自動重啟 Dock。" } } } },
    "Dock 已重新启动并恢复运行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Dock restarted and is running again." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Dock 已重新啟動並恢復運行。" } } } },
    "Dock 或启动台卡住、图标不更新，或自动隐藏失效。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Dock or Launchpad is stuck, icons do not update, or auto-hide has stopped working." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Dock 或啟動台卡住、圖示不更新，或自動隱藏失效。" } } } },
    "Finder 和桌面会短暂消失，macOS 随后自动重启 Finder。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finder and the desktop briefly disappear, then macOS restarts Finder." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Finder 和桌面會短暫消失，macOS 隨後自動重啟 Finder。" } } } },
    "Finder 已重新启动并恢复运行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finder restarted and is running again." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Finder 已重新啟動並恢復運行。" } } } },
    "上次未完成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Last Run Failed" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "上次未完成" } } } },
    "不中断界面" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Interface Interruption" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不中斷介面" } } } },
    "不会注销用户或退出 App；菜单栏工具会短暂重新连接。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This does not sign you out or quit apps; menu bar utilities reconnect briefly." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不會登出使用者或退出 App；選單列工具會短暫重新連線。" } } } },
    "不会退出正在运行的 App，也不改变 Dock 布局。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Running apps are not quit and the Dock layout is not changed." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不會退出正在運行的 App，也不改變 Dock 佈局。" } } } },
    "不删除原文件，不关闭正在编辑的文稿。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Original files are not deleted and open documents are not closed." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不刪除原檔案，不關閉正在編輯的文件。" } } } },
    "不删除文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Does Not Delete Files" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不刪除檔案" } } } },
    "不删除文件；正在进行的拷贝、移动或清空废纸篓可能中断。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Files are not deleted, but an active copy, move, or Trash-emptying operation may be interrupted." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不刪除檔案；正在進行的複製、移動或清空廢紙簍可能中斷。" } } } },
    "不需要全部运行，也没有一键优化" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run only the relevant task; there is no one-click optimization" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不需要全部運行，也沒有一鍵優化" } } } },
    "不需要管理员密码" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Administrator Password" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不需要管理員密碼" } } } },
    "只在出现具体异常时运行一项；执行前先看影响，执行后验证结果。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run one task only for a specific problem. Review its impact first, then verify the result." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只在出現具體異常時運行一項；執行前先看影響，執行後驗證結果。" } } } },
    "只重建预览缓存，或重启出现异常的 macOS 界面服务。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rebuild only the preview cache or restart a macOS interface service that is misbehaving." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只重建預覽快取，或重啟出現異常的 macOS 介面服務。" } } } },
    "尚未运行" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not Run Yet" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未運行" } } } },
    "快速预览缓存已重置，原文件没有改变。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Quick Look cache was reset; original files were unchanged." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "快速預覽快取已重置，原檔案沒有改變。" } } } },
    "文件缩略图空白，或按空格后仍显示旧预览。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "File thumbnails are blank, or pressing Space still shows an outdated preview." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "檔案縮圖空白，或按空白鍵後仍顯示舊預覽。" } } } },
    "最近一次维护" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Latest Maintenance" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "最近一次維護" } } } },
    "最近已完成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recently Completed" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "最近已完成" } } } },
    "桌面或文件窗口没有刷新，或 Finder 长时间无响应。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The desktop or file windows have not refreshed, or Finder has stopped responding." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "桌面或檔案視窗沒有重新整理，或 Finder 長時間無回應。" } } } },
    "每次只运行一项" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One Task at a Time" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每次只運行一項" } } } },
    "界面会短暂重载" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Interface Briefly Reloads" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "介面會短暫重新載入" } } } },
    "确认运行" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run Task" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認運行" } } } },
    "若 Dock 没有在数秒内返回，注销后重新登录可恢复。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "If the Dock does not return within a few seconds, sign out and back in to restore it." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "若 Dock 沒有在數秒內返回，登出後重新登入可恢復。" } } } },
    "若 Finder 没有自动返回，可通过 Spotlight 重新打开 Finder。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "If Finder does not return automatically, reopen it with Spotlight." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "若 Finder 沒有自動返回，可透過 Spotlight 重新開啟 Finder。" } } } },
    "若菜单栏没有在数秒内返回，注销后重新登录可恢复。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "If the menu bar does not return within a few seconds, sign out and back in to restore it." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "若選單列沒有在數秒內返回，登出後重新登入可恢復。" } } } },
    "菜单栏和控制中心会短暂消失，macOS 随后自动重启它们。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The menu bar and Control Center briefly disappear, then macOS restarts them." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選單列和控制中心會短暫消失，macOS 隨後自動重啟它們。" } } } },
    "菜单栏图标、控制中心或时钟没有刷新。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Menu bar icons, Control Center, or the clock have not refreshed." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選單列圖示、控制中心或時鐘沒有更新。" } } } },
    "菜单栏服务已重新启动并恢复运行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The menu bar service restarted and is running again." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選單列服務已重新啟動並恢復運行。" } } } },
    "运行 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "運行 %@" } } } },
    "运行此任务…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run This Task…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "運行此任務…" } } } },
    "这不是加速器" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This Is Not a Speed Booster" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這不是加速器" } } } },
    "选择你遇到的问题" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose the Problem You See" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇你遇到的問題" } } } },
    "重建快速预览缓存" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rebuild Quick Look Cache" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重建快速預覽快取" } } } },
    "重新启动 Dock" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restart Dock" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新啟動 Dock" } } } },
    "重新启动 Finder" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restart Finder" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新啟動 Finder" } } } },
    "重新启动菜单栏服务" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restart Menu Bar Service" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新啟動選單列服務" } } } },
    "重新选中文件并按空格；仍异常时可安全重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select the file again and press Space; retrying this task is safe if the issue remains." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新選取檔案並按空白鍵；仍異常時可安全重試。" } } } },
    "重置 Quick Look 缓存；第一次重新预览时可能稍慢。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset the Quick Look cache; the first new preview may be slightly slower." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重置 Quick Look 快取；第一次重新預覽時可能稍慢。" } } } },
    "适用于：%@\n\n会发生：%@\n\n安全边界：%@\n\n如果未恢复：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use when: %@\n\nWhat happens: %@\n\nSafety boundary: %@\n\nIf it does not recover: %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "適用於：%@\n\n會發生：%@\n\n安全邊界：%@\n\n如果未恢復：%@" } } } },
    "%d 项待查看" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d items to review" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 項待查看" } } } },
    "App 本体已移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "App bundle moved to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 本體已移到廢紙簍" } } } },
    "macOS 已报告严重内存压力。先查看占用进程，再决定是否退出。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS reports critical memory pressure. Review the top processes before deciding whether to quit one." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 已回報嚴重記憶體壓力。先查看佔用處理程式，再決定是否退出。" } } } },
    "macOS 已报告内存压力警告。查看连续采样和占用进程，再决定是否退出。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS reports elevated memory pressure. Review continuous samples and the top processes before deciding whether to quit one." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 已回報記憶體壓力警告。查看連續採樣和佔用處理程式，再決定是否退出。" } } } },
    "严重" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Critical" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "嚴重" } } } },
    "候选内容合计 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ in candidates" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "候選內容合計 %@" } } } },
    "先扫描缓存、下载中的安装包与归档，以及按设置启用的媒体与重复文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan caches, installers and archives in Downloads, plus media and duplicate files when enabled." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "先掃描快取、下載中的安裝套件與封存檔，以及按設定啟用的媒體與重複檔案。" } } } },
    "内存压力" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Memory Pressure" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "記憶體壓力" } } } },
    "内存压力正在升高" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Memory Pressure Is Rising" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "記憶體壓力正在升高" } } } },
    "内存压力较高" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Memory Pressure Is High" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "記憶體壓力較高" } } } },
    "内存已用 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ memory used" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "記憶體已用 %@" } } } },
    "原生实时采样" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Native live sampling" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "原生即時採樣" } } } },
    "发现 %d 项内容，合计 %@；其中 %d 项已按低风险规则预选。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Found %d items totaling %@; %d are preselected by low-risk rules." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "發現 %d 項內容，合計 %@；其中 %d 項已按低風險規則預選。" } } } },
    "只读查看，不会自动结束进程" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only view; no process is ended automatically" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀查看，不會自動結束處理程式" } } } },
    "可用空间偏低" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Available Space Is Low" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可用空間偏低" } } } },
    "启动磁盘只剩 %@（%@ 已使用）。建议先扫描，再逐项确认。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only %@ remains on the startup disk (%@ used). Scan first, then review each item." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟動磁碟只剩 %@（%@ 已使用）。建議先掃描，再逐項確認。" } } } },
    "实时本机数据" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Live data from this Mac" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "即時本機資料" } } } },
    "已使用 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ used" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已使用 %@" } } } },
    "已移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Moved to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已移到廢紙簍" } } } },
    "常用任务" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Common Tasks" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "常用任務" } } } },
    "当前没有需要立即处理的项目" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing Needs Immediate Attention" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前沒有需要立即處理的項目" } } } },
    "当前状态" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current Status" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前狀態" } } } },
