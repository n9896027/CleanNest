    "GitHub 暂时限制了检查频率，请稍后再试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub has temporarily rate-limited update checks. Try again later." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 暫時限制了檢查頻率，請稍後再試。" } } } },
    "GitHub 更新服务暂时不可用（HTTP %d）。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub's update service is temporarily unavailable (HTTP %d)." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 更新服務暫時無法使用（HTTP %d）。" } } } },
