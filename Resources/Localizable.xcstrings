    "安全与权限" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Security & Permissions" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安全與權限" } } } },
    "扫描范围" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan Scope" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "掃描範圍" } } } },
    "关于 CleanNest" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "About CleanNest" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關於 CleanNest" } } } },
    "清理空间。所有项目先预览，执行时只会移到废纸篓。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clean Up. Preview every item; confirmed items only move to Trash." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "清理空間。所有項目先預覽，執行時只會移到垃圾桶。" } } } },
    "所有项目先预览，执行时只会移到废纸篓。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Preview every item; confirmed items only move to Trash." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "所有項目先預覽，執行時只會移到垃圾桶。" } } } },
    "安全模式已开启" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safe Mode Is On" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安全模式已開啟" } } } },
    "开始扫描" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開始掃描" } } } },
    "重新扫描" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan Again" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新掃描" } } } },
    "移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "移到垃圾桶" } } } },
    "认证并移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Authenticate and Move to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "驗證並移到垃圾桶" } } } },
    "需要管理员认证" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Administrator Authentication Required" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要管理員驗證" } } } },
    "此 App 不是当前账户所有。确认卸载后，macOS 会用原生窗口完成认证；CleanNest 不会看到、读取或保存你的密码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This app is not owned by the current account. After you confirm, macOS authenticates in its native dialog; CleanNest never sees, reads, or stores your password." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此 App 不屬於目前帳戶。確認解除安裝後，macOS 會以原生視窗完成驗證；CleanNest 不會看到、讀取或儲存你的密碼。" } } } },
    "App 状态已经变化" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The App Has Changed" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 狀態已變更" } } } },
    "当前路径无法通过安全校验。请重新扫描；CleanNest 不会对未知目标尝试卸载。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The current path failed safety validation. Scan again; CleanNest will not try to uninstall an unknown target." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前路徑無法通過安全驗證。請重新掃描；CleanNest 不會嘗試解除安裝未知目標。" } } } },
    "先由 macOS 完成管理员认证，再移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Authenticate with macOS first, then move to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "先由 macOS 完成管理員驗證，再移到垃圾桶" } } } },
    "需要管理员权限的任务会使用 macOS 原生认证流程，不会让 App 读取或保存密码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tasks that need administrator access use native macOS authentication; the app never reads or stores passwords." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要管理員權限的工作會使用 macOS 原生驗證流程，不會讓 App 讀取或儲存密碼。" } } } },
    "卸载 %@？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uninstall %@?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "解除安裝 %@？" } } } },
    "这个 App" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This App" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這個 App" } } } },
    "这个 App 由系统或其他管理员账户安装。下一步 macOS 会显示原生管理员认证；CleanNest 不会读取或保存密码。认证成功并确认 App 已进入废纸篓后，才会处理 %d 个相关项目。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This app was installed by the system or another administrator account. macOS will show native administrator authentication next; CleanNest never reads or stores your password. The %d related items are handled only after macOS confirms the app is in Trash." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此 App 由系統或其他管理員帳戶安裝。下一步 macOS 會顯示原生管理員驗證；CleanNest 不會讀取或儲存密碼。驗證成功並確認 App 已進入垃圾桶後，才會處理 %d 個相關項目。" } } } },
    "App 本体和 %d 个相关项目将移到废纸篓。只有确认 App 本体成功后，CleanNest 才会处理相关项目。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The app and %d related items will move to Trash. CleanNest handles related items only after confirming the app itself moved successfully." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 本體和 %d 個相關項目將移到垃圾桶。只有確認 App 本體成功後，CleanNest 才會處理相關項目。" } } } },
    "全部移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move Everything to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "全部移到垃圾桶" } } } },
    "认证并卸载 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Authenticate and Uninstall %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "驗證並解除安裝 %@" } } } },
