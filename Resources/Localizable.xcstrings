    "每一步都对应真实本机状态；点击任一步可继续。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Every step reflects real local state. Select a step to continue." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每一步都對應真實本機狀態；點擊任一步可繼續。" } } } },
    "闭环已建立" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loop Complete" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "閉環已建立" } } } },
