    "状态数据不完整" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Status Data Incomplete" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "狀態資料不完整" } } } },
    "资源占用值得留意" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resource Usage Needs Attention" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "資源佔用值得留意" } } } },
    "当前负载较高" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current Load Is High" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前負載較高" } } } },
    "macOS 仍有足够内存可供应用使用，无需为了降低“已用”百分比而关闭 App。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS still has enough memory for apps. There is no need to quit apps merely to lower the used percentage." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "macOS 仍有足夠記憶體可供 App 使用，無需為了降低「已用」百分比而關閉 App。" } } } },
    "内存占用高不等于内存不足。macOS 会主动利用空闲内存做缓存，并在其他 App 需要时回收。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "High memory usage is not the same as low memory. macOS uses free memory for cache and reclaims it when other apps need it." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "記憶體佔用高不等於記憶體不足。macOS 會主動利用閒置記憶體作為快取，並在其他 App 需要時回收。" } } } },
    "下方进程数值是单次采样的内存足迹近似值；共享内存、压缩内存和统一内存的计算方式不同，进程相加不会等于系统已用内存。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Process values below are approximate footprints from one sample. Shared, compressed, and unified memory are counted differently, so process totals will not equal system used memory." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下方程序數值是單次採樣的記憶體足跡近似值；共享記憶體、壓縮記憶體和統一記憶體的計算方式不同，程序相加不會等於系統已用記憶體。" } } } },
    "Python 运行时；常见于本机 AI、数据处理或开发脚本。为保护隐私，CleanNest 未读取命令行参数，因此不能确认具体项目。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Python runtime, commonly used by on-device AI, data processing, or developer scripts. CleanNest does not read command-line arguments, so it cannot identify the specific project." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Python 執行環境；常見於本機 AI、資料處理或開發腳本。為保護隱私，CleanNest 未讀取命令列參數，因此無法確認具體專案。" } } } },
    "未读取命令行参数，无法确认该进程的具体用途。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Command-line arguments were not read, so this process's exact purpose is unknown." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未讀取命令列參數，無法確認該程序的具體用途。" } } } },
    "每 60 秒本机采样；保留 %d 天，不上传。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sampled locally every 60 seconds; retained for %d days and never uploaded." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每 60 秒本機採樣；保留 %d 天，不上傳。" } } } },
    "每 60 秒本机采样；当前显示 %d 个数据点。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sampled locally every 60 seconds; showing %d data points." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每 60 秒本機採樣；目前顯示 %d 個資料點。" } } } },
