    "自动（服务默认：%@）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic (service default: %@)" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動（服務預設：%@）" } } } },
