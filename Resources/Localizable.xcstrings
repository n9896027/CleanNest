    "持续采样" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continuous sampling" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "持續採樣" } } } },
    "等待引擎" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for engine" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "等待引擎" } } } },
    "等待连续样本" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for continuous samples" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "等待連續樣本" } } } },
    "CleanNest 每 60 秒在本机记录一次 CPU、内存与磁盘占用。首次启动后稍等片刻即可看到趋势。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest records CPU, memory, and disk usage locally every 60 seconds. Trends appear after a few samples." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 每 60 秒在本機記錄一次 CPU、記憶體與磁碟佔用。首次啟動後稍候即可看到趨勢。" } } } },
    "1 小时" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "1 Hour" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "1 小時" } } } },
