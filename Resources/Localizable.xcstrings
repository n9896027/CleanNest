    "查看原因、峰值和持续时间。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review causes, peaks, and duration."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看原因、峰值和持續時間。"}}}},
    "原生实时监测已可用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Native Live Monitoring Is Available"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"原生即時監測已可用"}}}},
