    "本机 MLX 模型目录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local MLX model folder" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機 MLX 模型目錄" } } } },
    "mlx_lm.server 可执行文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "mlx_lm.server executable" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "mlx_lm.server 執行檔" } } } },
    "只发送名称、脱敏路径、大小、类型、时间和扫描说明；不读取文件内容，AI 也不能勾选或删除。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only names, redacted paths, sizes, types, dates, and scan context are sent. File contents are not read, and AI cannot select or delete items." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只傳送名稱、去識別路徑、大小、類型、時間與掃描說明；不讀取檔案內容，AI 也不能勾選或刪除。" } } } },
    "诊断详情" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Diagnostic Details" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "診斷詳情" } } } },
