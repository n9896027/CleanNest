    "只扫描，不会自动更改文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan only—no automatic file changes" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只掃描，不會自動更改檔案" } } } },
