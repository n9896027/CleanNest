    "暂停" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫停" } } } },
    "重新启用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Again" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新啟用" } } } },
    "撤销" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "撤銷" } } } },
    "模型工作台" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Model Workbench" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "模型工作台" } } } },
    "运行最小测速" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run Minimal Benchmark" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "執行最小測速" } } } },
