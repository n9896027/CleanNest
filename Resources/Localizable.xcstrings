    "先查看，再决定。扫描和清理都在本机完成。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Inspect first, then decide. Scanning and cleanup stay on this Mac." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "先查看，再決定。掃描和清理都在本機完成。" } } } },
    "连接开源清理引擎" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect the Open-Source Engine" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連接開源清理引擎" } } } },
    "去设置" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Settings" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "前往設定" } } } },
    "磁盘浏览。从文件夹大小出发，找到空间真正去了哪里。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disk Browser. Start with folder sizes and find where your space really went." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "磁碟瀏覽。從資料夾大小出發，找出空間真正去了哪裡。" } } } },
    "从文件夹大小出发，找到空间真正去了哪里。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start with folder sizes and find where your space really went." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "從資料夾大小出發，找出空間真正去了哪裡。" } } } },
    "选择文件夹" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose Folder" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇資料夾" } } } },
    "开始分析" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Analyze" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開始分析" } } } },
    "重新分析" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Analyze Again" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新分析" } } } },
    "取消" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "取消" } } } },
    "主目录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Home" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "主目錄" } } } },
    "空间地图" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Space Map" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "空間地圖" } } } },
    "面积代表占用大小；点击文件夹继续下钻，点击文件在 Finder 中确认。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Area represents size. Open folders to drill down, or inspect files in Finder." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "面積代表佔用大小；點擊資料夾繼續下鑽，點擊檔案在 Finder 中確認。" } } } },
    "只读浏览" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀瀏覽" } } } },
    "可再生成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Regenerable" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可重新產生" } } } },
    "需逐项确认" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review item by item" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需逐項確認" } } } },
    "用户内容" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "User content" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用者內容" } } } },
    "受保护/未知" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Protected / unknown" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "受保護／未知" } } } },
    "正在建立用途与可清理性证据" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Building purpose and cleanup evidence" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在建立用途與可清理性證據" } } } },
    "正在计算当前层级" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calculating this level" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在計算目前層級" } } } },
    "空间分布" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Space Distribution" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "空間分布" } } } },
    "浏览页保持只读" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disk Browser Stays Read-only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "瀏覽頁維持唯讀" } } } },
    "首版不会从任意文件夹直接删除内容。请先在 Finder 中确认，或使用“清理空间”里的安全范围。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This view never deletes from arbitrary folders. Confirm in Finder or use the guarded Clean Up scope." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此頁不會從任意資料夾直接刪除內容。請先在 Finder 中確認，或使用「清理空間」的安全範圍。" } } } },
    "系统状态。本机采样；不上传指标，只在你确认后结束所选进程。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System Status. Sampled locally; metrics are not uploaded, and selected processes stop only after confirmation." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "系統狀態。本機採樣；不上傳指標，只在你確認後結束所選程序。" } } } },
    "本机采样；不上传指标，只在你确认后结束所选进程。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sampled locally; metrics are not uploaded, and selected processes stop only after confirmation." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機採樣；不上傳指標，只在你確認後結束所選程序。" } } } },
    "刷新" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新整理" } } } },
    "资源趋势" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resource Trends" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "資源趨勢" } } } },
    "持续采样" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continuous sampling" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "持續採樣" } } } },
    "等待引擎" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for engine" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "等待引擎" } } } },
    "等待连续样本" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for continuous samples" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "等待連續樣本" } } } },
    "CleanNest 每 60 秒在本机记录一次 CPU、内存与磁盘占用。首次启动后稍等片刻即可看到趋势。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest records CPU, memory, and disk usage locally every 60 seconds. Trends appear after a few samples." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 每 60 秒在本機記錄一次 CPU、記憶體與磁碟佔用。首次啟動後稍候即可看到趨勢。" } } } },
    "1 小时" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "1 Hour" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "1 小時" } } } },
    "24 小时" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "24 Hours" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "24 小時" } } } },
    "7 天" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "7 Days" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "7 天" } } } },
    "30 天" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "30 Days" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "30 天" } } } },
    "90 天" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "90 Days" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "90 天" } } } },
    "1 年" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "1 Year" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "1 年" } } } },
    "设置。引擎、权限与扫描范围都由你掌控。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings. You control the engine, permissions, and scan scope." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "設定。引擎、權限與掃描範圍都由你掌控。" } } } },
    "引擎、权限与扫描范围都由你掌控。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You control the engine, permissions, and scan scope." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "引擎、權限與掃描範圍都由你掌控。" } } } },
    "本地引擎" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local Engine" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機引擎" } } } },
    "本机 AI 分析" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device AI Analysis" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機 AI 分析" } } } },
    "历史指标" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Metric History" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "歷史指標" } } } },
    "连续本机采样" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continuous Local Sampling" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "持續本機採樣" } } } },
    "每 60 秒记录 CPU、内存、磁盘、电池与温度；使用 SQLite WAL，只保存在这台 Mac。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Records CPU, memory, disk, battery, and temperature every 60 seconds using SQLite WAL. Data stays on this Mac." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每 60 秒記錄 CPU、記憶體、磁碟、電池與溫度；使用 SQLite WAL，只保存在這台 Mac。" } } } },
    "保留期限" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Retention" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "保留期限" } } } },
    "删除历史指标" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete Metric History" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除歷史指標" } } } },
    "只读 MCP" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only MCP" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀 MCP" } } } },
    "把 CleanNest 的本机证据交给你的 AI 客户端读取" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Let your AI client read CleanNest evidence" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "讓你的 AI 客戶端讀取 CleanNest 本機證據" } } } },
    "仅通过本机标准输入/输出运行；没有 HTTP 端口，没有删除、结束进程或修改设置的工具。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Runs only over local standard input/output. No HTTP port and no tools for deletion, process termination, or settings changes." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅透過本機標準輸入／輸出執行；沒有 HTTP 連接埠，也沒有刪除、結束程序或修改設定的工具。" } } } },
    "只读" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀" } } } },
    "复制路径" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy Path" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "複製路徑" } } } },
    "复制配置" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy Config" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "複製設定" } } } },
    "安全与权限" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Security & Permissions" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安全與權限" } } } },
    "扫描范围" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan Scope" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "掃描範圍" } } } },
    "关于 CleanNest" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "About CleanNest" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關於 CleanNest" } } } },
    "清理空间。所有项目先预览，执行时只会移到废纸篓。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clean Up. Preview every item; confirmed items only move to Trash." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "清理空間。所有項目先預覽，執行時只會移到垃圾桶。" } } } },
    "所有项目先预览，执行时只会移到废纸篓。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Preview every item; confirmed items only move to Trash." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "所有項目先預覽，執行時只會移到垃圾桶。" } } } },
    "安全模式已开启" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safe Mode Is On" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安全模式已開啟" } } } },
    "推荐项" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recommended" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "建議項目" } } } },
    "把可重建缓存、下载文件、个人媒体与重复副本分开判断。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review rebuildable caches, downloads, personal media, and duplicate copies separately." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將可重建快取、下載檔案、個人媒體與重複副本分開判斷。" } } } },
    "个人下载和媒体默认不勾选；重复文件执行前会重新核验保留副本与 SHA-256，失败时不会改为永久删除。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloads and personal media are never preselected. Duplicate cleanup rechecks the retained copy and SHA-256 before execution, and never falls back to permanent deletion." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "個人下載與媒體預設不勾選；重複檔案執行前會重新核驗保留副本與 SHA-256，失敗時不會改為永久刪除。" } } } },
    "搜索名称或路径" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Search names or paths" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "搜尋名稱或路徑" } } } },
    "下次扫描：媒体与重复文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Next scan: Media & duplicates" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下次掃描：媒體與重複檔案" } } } },
    "下次扫描：应用缓存" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Next scan: App caches" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下次掃描：App 快取" } } } },
    "只在本机读取媒体元数据；仅对同尺寸文件计算 SHA-256，不上传文件或哈希。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reads media metadata on this Mac only. SHA-256 is computed only for same-size files; neither files nor hashes are uploaded." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只在本機讀取媒體中繼資料；僅對相同大小的檔案計算 SHA-256，不上傳檔案或雜湊。" } } } },
    "应用缓存默认不扫描；开启后也不会自动勾选。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "App caches are excluded by default and are not preselected when enabled." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 快取預設不掃描；開啟後也不會自動勾選。" } } } },
    "先扫描，再做决定" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan First, Then Decide" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "先掃描，再做決定" } } } },
    "CleanNest 会检查缓存、下载归档和大型媒体；启用媒体分析时还会用本机 SHA-256 查找字节完全相同的副本。扫描不会改动文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest checks caches, downloaded archives, and large media. When media analysis is enabled, on-device SHA-256 also finds byte-identical copies. Scanning never changes files." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest 會檢查快取、下載封存檔與大型媒體；啟用媒體分析時，也會用本機 SHA-256 尋找位元組完全相同的副本。掃描不會更動檔案。" } } } },
    "本机文件证据" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device File Evidence" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機檔案證據" } } } },
    "先判断来源与内容关系，再让你决定；扫描结果本身不会删除文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Establish provenance and content relationships before you decide. Scan results never delete files." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "先判斷來源與內容關係，再由你決定；掃描結果本身不會刪除檔案。" } } } },
    "仅在本机" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On This Mac Only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅在本機" } } } },
    "下载文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloads" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下載檔案" } } } },
    "个人媒体" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Personal Media" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "個人媒體" } } } },
    "完全重复" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Exact Duplicates" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "完全重複" } } } },
    "检查范围" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan Scope" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "檢查範圍" } } } },
    "未启用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not Enabled" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未啟用" } } } },
    "%d 个安装包 · %d 个归档" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d installers · %d archives" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 個安裝檔 · %d 個封存檔" } } } },
    "图 %d · 视频 %d · 音频 %d" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Images %d · Videos %d · Audio %d" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "圖片 %d · 影片 %d · 音訊 %d" } } } },
    "%d 组" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d groups" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 組" } } } },
    "%d 个副本 · %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d copies · %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 個副本 · %@" } } } },
    "%d 个文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d files" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 個檔案" } } } },
    "达到本轮安全上限" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Safety Limit Reached" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已達本輪安全上限" } } } },
    "有界扫描已完成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bounded Scan Complete" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "有界掃描已完成" } } } },
    "媒体候选门槛：至少 14 天未修改，图片 ≥ 5 MB、视频 ≥ 100 MB、音频 ≥ 20 MB；重复检测只比较 ≥ 1 MB 的本地完整文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Media thresholds: unchanged for at least 14 days; images ≥ 5 MB, videos ≥ 100 MB, audio ≥ 20 MB. Duplicate detection compares complete local files ≥ 1 MB only." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "媒體候選門檻：至少 14 天未修改，圖片 ≥ 5 MB、影片 ≥ 100 MB、音訊 ≥ 20 MB；重複偵測只比較 ≥ 1 MB 的本機完整檔案。" } } } },
    "同一文件可能同时属于下载/媒体与完全重复，所以上方数量不能直接相加；列表保留原始类型，并用“字节完全相同”标记重叠项目。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A file can be both a download or media item and an exact duplicate, so the counts above are not additive. The list keeps the original type and marks overlaps as Byte-identical." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "同一檔案可能同時屬於下載／媒體與完全重複，因此上方數量不能直接相加；清單保留原始類型，並以「位元組完全相同」標記重疊項目。" } } } },
    "为控制耗时，本轮在文件或哈希上限处停止；结果是部分集合。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "To bound runtime, this scan stopped at the file or hash limit; results are partial." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "為控制耗時，本輪在檔案或雜湊上限處停止；結果為部分集合。" } } } },
    "跳过 %d 个尚未完整下载的云端占位文件，避免触发下载。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Skipped %d cloud placeholders that were not fully downloaded to avoid triggering downloads." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已跳過 %d 個尚未完整下載的雲端預留檔案，避免觸發下載。" } } } },
    "字节完全相同" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Byte-identical" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "位元組完全相同" } } } },
    "下载安装介质" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloaded Installer" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下載安裝媒體" } } } },
    "资料归档 · 需复核" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Data Archive · Review" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "資料封存檔 · 需複核" } } } },
    "个人媒体 · 手动选择" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Personal Media · Manual Choice" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "個人媒體 · 手動選擇" } } } },
    "开发缓存" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Developer Caches" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開發快取" } } } },
    "包管理器缓存" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Package-manager Caches" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "套件管理器快取" } } } },
    "旧日志" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Old Logs" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "舊記錄檔" } } } },
    "安装包" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installers" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝檔" } } } },
    "下载压缩包" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloaded Archives" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下載壓縮檔" } } } },
    "图片文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Images" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "圖片檔案" } } } },
    "视频文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Videos" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "影片檔案" } } } },
    "音频文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "音訊檔案" } } } },
    "重复文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Duplicates" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重複檔案" } } } },
    "应用残留" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "App Leftovers" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 殘留" } } } },
    "%@，%d 项，%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@, %d items, %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@，%d 項，%@" } } } },
    "收起分组" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Collapse group" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "收合群組" } } } },
    "展开查看全部项目" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Expand to view all items" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "展開查看全部項目" } } } },
    "候选体积 %@，实际 APFS 释放量以清空废纸篓后为准。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Candidate footprint: %@. Actual APFS space is measurable only after Trash is emptied." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "候選體積 %@；實際 APFS 釋放量以清空垃圾桶後為準。" } } } },
    "其中 %d 项属于下载或个人媒体，请确认不再需要。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d selected items are downloads or personal media. Confirm that you no longer need them." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "其中 %d 項屬於下載或個人媒體，請確認已不再需要。" } } } },
    "%d 个重复副本会在移动前再次核验内容，并确保扫描时选定的保留副本仍存在。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d duplicate copies will be revalidated before moving, including the retained copy selected during scanning." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 個重複副本會在移動前再次核驗內容，並確認掃描時選定的保留副本仍存在。" } } } },
    "这些内容可在清空废纸篓前恢复。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "These items remain recoverable until Trash is emptied." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這些內容在清空垃圾桶前仍可復原。" } } } },
    "开始扫描" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開始掃描" } } } },
    "重新扫描" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan Again" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新掃描" } } } },
    "移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "移到垃圾桶" } } } },
    "认证并移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Authenticate and Move to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "驗證並移到垃圾桶" } } } },
    "需要管理员认证" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Administrator Authentication Required" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要管理員驗證" } } } },
    "此 App 不是当前账户所有。确认卸载后，macOS 会用原生窗口完成认证；CleanNest 不会看到、读取或保存你的密码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This app is not owned by the current account. After you confirm, macOS authenticates in its native dialog; CleanNest never sees, reads, or stores your password." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此 App 不屬於目前帳戶。確認解除安裝後，macOS 會以原生視窗完成驗證；CleanNest 不會看到、讀取或儲存你的密碼。" } } } },
    "App 状态已经变化" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The App Has Changed" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 狀態已變更" } } } },
    "当前路径无法通过安全校验。请重新扫描；CleanNest 不会对未知目标尝试卸载。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The current path failed safety validation. Scan again; CleanNest will not try to uninstall an unknown target." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前路徑無法通過安全驗證。請重新掃描；CleanNest 不會嘗試解除安裝未知目標。" } } } },
    "先由 macOS 完成管理员认证，再移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Authenticate with macOS first, then move to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "先由 macOS 完成管理員驗證，再移到垃圾桶" } } } },
    "需要管理员权限的任务会使用 macOS 原生认证流程，不会让 App 读取或保存密码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tasks that need administrator access use native macOS authentication; the app never reads or stores passwords." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要管理員權限的工作會使用 macOS 原生驗證流程，不會讓 App 讀取或儲存密碼。" } } } },
    "卸载 %@？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uninstall %@?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "解除安裝 %@？" } } } },
    "这个 App" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This App" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這個 App" } } } },
    "这个 App 由系统或其他管理员账户安装。下一步 macOS 会显示原生管理员认证；CleanNest 不会读取或保存密码。认证成功并确认 App 已进入废纸篓后，才会处理 %d 个相关项目。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This app was installed by the system or another administrator account. macOS will show native administrator authentication next; CleanNest never reads or stores your password. The %d related items are handled only after macOS confirms the app is in Trash." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此 App 由系統或其他管理員帳戶安裝。下一步 macOS 會顯示原生管理員驗證；CleanNest 不會讀取或儲存密碼。驗證成功並確認 App 已進入垃圾桶後，才會處理 %d 個相關項目。" } } } },
    "App 本体和 %d 个相关项目将移到废纸篓。只有确认 App 本体成功后，CleanNest 才会处理相关项目。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The app and %d related items will move to Trash. CleanNest handles related items only after confirming the app itself moved successfully." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "App 本體和 %d 個相關項目將移到垃圾桶。只有確認 App 本體成功後，CleanNest 才會處理相關項目。" } } } },
    "全部移到废纸篓" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move Everything to Trash" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "全部移到垃圾桶" } } } },
    "认证并卸载 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Authenticate and Uninstall %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "驗證並解除安裝 %@" } } } },
    "卸载 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uninstall %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "解除安裝 %@" } } } },
    "完成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "完成" } } } },
    "复制" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "複製" } } } },
    "本地运行" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Runs Locally" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機執行" } } } },
    "部分功能待设置" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some Features Need Setup" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分功能待設定" } } } },
    "演示数据" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Demo Data" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "展示資料" } } } },
    "启动磁盘" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Startup Disk" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟動磁碟" } } } },
    "已使用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Used" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已使用" } } } },
