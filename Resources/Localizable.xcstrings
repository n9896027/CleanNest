    "IOKit 未返回内置电池" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"IOKit returned no internal battery"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"IOKit 未返回內置電池"}}}},
    "全局快捷键已关闭。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The global shortcut is off."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"全局快捷鍵已關閉。"}}}},
    "⌘⌥M 已由 macOS 注册，不需要辅助功能权限。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"⌘⌥M is registered with macOS and requires no Accessibility permission."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"⌘⌥M 已由 macOS 註冊，不需要輔助功能權限。"}}}},
    "⌘⌥M 注册失败（系统状态 %@），可能已被其他 App 占用。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"⌘⌥M registration failed (system status %@) and may already be used by another app."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"⌘⌥M 註冊失敗（系統狀態 %@），可能已被其他 App 佔用。"}}}},
