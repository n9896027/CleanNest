    "主目录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Home" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "主目錄" } } } },
    "空间地图" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Space Map" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "空間地圖" } } } },
    "面积代表占用大小；点击文件夹继续下钻，点击文件在 Finder 中确认。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Area represents size. Open folders to drill down, or inspect files in Finder." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "面積代表佔用大小；點擊資料夾繼續下鑽，點擊檔案在 Finder 中確認。" } } } },
    "只读浏览" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀瀏覽" } } } },
