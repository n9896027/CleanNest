    "%@ · DFlash 加速草稿（不要直接选择）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ · DFlash acceleration draft (do not select directly)" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ · DFlash 加速草稿（請勿直接選擇）" } } } },
    "oMLX 调用必须使用 /v1/models 返回的短名；下方目录只用于 CleanNest 自己启动 mlx_lm.server。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "oMLX calls must use an ID returned by /v1/models. The folder below is only for mlx_lm.server started by CleanNest." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "oMLX 呼叫必須使用 /v1/models 回傳的短名；下方目錄只供 CleanNest 自行啟動 mlx_lm.server。" } } } },
    "目录路径" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Folder Path" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目錄路徑" } } } },
