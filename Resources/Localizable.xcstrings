    "GitHub 版本标签格式无法识别：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unrecognized GitHub version tag: %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 版本標籤格式無法識別：%@" } } } },
    "GitHub 返回的下载页面不属于 CleanNest 官方仓库。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The download page returned by GitHub does not belong to the official CleanNest repository." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 傳回的下載頁面不屬於 CleanNest 官方倉庫。" } } } },
