    "预览 App 本体与精确匹配的相关文件" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Preview the app bundle and precisely matched related files" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "預覽 App 本體與精確匹配的相關檔案" } } } },
    "本机工作台" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device Workspace" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機工作台" } } } },
    "只读容量快照" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read-only capacity snapshot" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "唯讀容量快照" } } } },
    "选择一个明确任务，CleanNest 不会替你自动删除" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a clear task. CleanNest never deletes on your behalf." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇一個明確任務，CleanNest 不會替你自動刪除" } } } },
