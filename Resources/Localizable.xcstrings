    "建立第一条本机偏好" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create Your First Local Preference" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "建立第一條本機偏好" } } } },
    "可检查、撤销或随时清空，不上传文件内容。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review, undo, or clear it anytime. File contents are never uploaded." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可檢查、撤銷或隨時清空，不上傳檔案內容。" } } } },
    "把你的明确判断变成下次更清楚的排序；不会擅自替你删除文件。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn explicit choices into clearer future ordering. CleanNest never deletes files on its own." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "把你的明確判斷變成下次更清楚的排序；不會擅自替你刪除檔案。" } } } },
    "它还不了解你的取舍" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "It Does Not Know Your Preferences Yet" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "它還不了解你的取捨" } } } },
    "扫描并建立第一条偏好" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan and Create the First Preference" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "掃描並建立第一條偏好" } } } },
    "设置本机模型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set Up a Local Model" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "設定本機模型" } } } },
    "下次解释" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Explain Next Time" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下次解釋" } } } },
    "明确选择清理或保留" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose clean or keep explicitly" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "明確選擇清理或保留" } } } },
    "只记录偏好与理由" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Store only the preference and reason" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只記錄偏好與理由" } } } },
    "排序时标出学习依据" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show learned evidence when ordering" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "排序時標出學習依據" } } } },
    "只保存项目类型、你的选择和模型评价；不保存文件内容或完整路径。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stores only item types, your choices, and model feedback—not file contents or full paths." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只儲存項目類型、你的選擇和模型評價；不儲存檔案內容或完整路徑。" } } } },
    "CleanNest · 开发构建" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest · Development Build" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest · 開發構建" } } } },
    "CleanNest %@ · 构建 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest %@ · Build %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "CleanNest %@ · 構建 %@" } } } },
    "还有 %@ 可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ available" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "還有 %@ 可用" } } } },
    "在 %@ 的磁盘中，已使用 %@。先扫描可清理内容，再逐项确认。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ total, with %@ used. Scan reclaimable items first, then review each one." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 %@ 的磁碟中，已使用 %@。先掃描可清理內容，再逐項確認。" } } } },
