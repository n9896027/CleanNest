    "从主目录开始定位空间占用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start from Home to locate storage use" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "從主目錄開始定位空間佔用" } } } },
