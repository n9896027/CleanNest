    "共 %@ · 仍有 %@ 可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ total · %@ available" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "共 %@ · 仍有 %@ 可用" } } } },
