    "发现新版本 %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Version %@ Is Available" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "發現新版本 %@" } } } },
    "当前版本 %@，正在读取公开的 GitHub Release。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. Reading the public GitHub Release." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@，正在讀取公開的 GitHub Release。" } } } },
    "当前版本为 %@。仓库目前没有正式 Release；维护者发布后，这里会自动参与版本比较。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. The repository has no official Release yet; future releases will be compared here automatically." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本為 %@。倉庫目前沒有正式 Release；維護者發布後，這裡會自動參與版本比較。" } } } },
    "当前版本 %@，最新正式版本 %@。CleanNest 不会自动替换 App，请前往 GitHub 核对说明后下载。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. Latest official version: %@. CleanNest never replaces the app automatically; review the release on GitHub before downloading." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@，最新正式版本 %@。CleanNest 不會自動替換 App，請前往 GitHub 核對說明後下載。" } } } },
    "当前版本 %@ 已与 GitHub 最新正式版本一致。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Version %@ matches the latest official GitHub Release." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@ 已與 GitHub 最新正式版本一致。" } } } },
    "当前版本 %@，GitHub 最新正式版本 %@。你可能正在使用开发构建。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current version: %@. Latest official GitHub version: %@. You may be using a development build." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本 %@，GitHub 最新正式版本 %@。你可能正在使用開發構建。" } } } },
    "仅在你点击检查时访问 GitHub；会发送当前 App 版本，GitHub 可看到 IP 等常规网络信息，但不会收到文件清单或扫描结果。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub is contacted only when you check. The current app version is sent, and GitHub can see normal network data such as your IP address; file lists and scan results are never sent." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅在你點擊檢查時存取 GitHub；會傳送目前 App 版本，GitHub 可看到 IP 等一般網路資訊，但不會收到檔案清單或掃描結果。" } } } },
    "从 GitHub 获取最新正式版本；不会自动安装。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checks the latest official GitHub Release; never installs automatically." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "從 GitHub 取得最新正式版本；不會自動安裝。" } } } },
    "正在读取 GitHub 最新正式 Release…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reading the latest official GitHub Release…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在讀取 GitHub 最新正式 Release…" } } } },
    "GitHub 目前尚未发布正式版本。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GitHub has no official Release yet." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "GitHub 目前尚未發布正式版本。" } } } },
    "可更新到 %@。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Version %@ is available." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可更新到 %@。" } } } },
    "当前已是最新正式版本。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You have the latest official version." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前已是最新正式版本。" } } } },
