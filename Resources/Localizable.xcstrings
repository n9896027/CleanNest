    "高风险·先下钻" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"High risk · Drill down first"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"高風險·先下鑽"}}}},
    "需要逐项确认" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Requires Item-by-Item Review"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要逐項確認"}}}},
    "本机安全规则：当前目录只供继续查看，不能作为整体清理目标。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device safety rule: this directory is for further inspection only and cannot be cleaned as a whole."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機安全規則：當前目錄只供繼續查看，不能作為整體清理目標。"}}}},
    "本机安全规则：仅作为低风险候选，仍需逐项复核后由你决定。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device safety rule: this is only a low-risk candidate; review each item and decide yourself."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機安全規則：僅作為低風險候選，仍需逐項復核後由你決定。"}}}},
    "本机安全规则：当前目录保持不动，只能在所属 App 的设置中管理。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device safety rule: this directory remains untouched and can only be managed in the owning app’s settings."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機安全規則：當前目錄保持不動，只能在所屬 App 的設定中管理。"}}}},
    "本机安全规则：建议保留，当前目录不会进入清理流程。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device safety rule: keeping is recommended; this directory will not enter the cleanup workflow."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機安全規則：建議保留，當前目錄不會進入清理流程。"}}}},
    "正在检查本地引擎…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking the local engine…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在檢查本機引擎…"}}}},
    "尚未检查" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not Checked Yet"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未檢查"}}}},
    "等待检测" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for Check"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"等待檢測"}}}},
    "尚未读取系统电源接口。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The system power interface has not been read."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未讀取系統電源接口。"}}}},
    "正在准备本机历史记录…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing on-device history…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在準備本機歷史記錄…"}}}},
    "正在准备菜单栏实时监测…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing live menu bar monitoring…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在準備選單列即時監測…"}}}},
    "正在确认菜单栏显示状态…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirming menu bar visibility…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在確認選單列顯示狀態…"}}}},
    "正在注册 ⌘⌥M…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Registering ⌘⌥M…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在註冊 ⌘⌥M…"}}}},
    "正在读取登录启动状态…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading login launch status…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在讀取登錄啓動狀態…"}}}},
    "尚未扫描本机模型" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device models have not been scanned"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未掃描本機模型"}}}},
