    "正在运行" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Running"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在運行"}}}},
    "未提供 Bundle ID" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Bundle ID Provided"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未提供 Bundle ID"}}}},
    "CleanNest 不会静默强制结束正在运行的 App。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"CleanNest never silently force-quits a running app."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"CleanNest 不會靜默強制結束正在運行的 App。"}}}},
    "请求退出" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Request Quit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請求退出"}}}},
    "受保护的相关文件尚未检查" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Protected Related Files Not Checked"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"受保護的相關檔案尚未檢查"}}}},
    "为避免连续授权弹窗，CleanNest 已跳过 Application Support、Containers 和 Group Containers；当前列表只包含能够安全读取的位置。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"To avoid repeated authorization prompts, CleanNest skipped Application Support, Containers, and Group Containers. Only safely readable locations are listed."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"為避免連續授權彈窗，CleanNest 已跳過 Application Support、Containers 和 Group Containers；當前列表只包含能夠安全讀取的位置。"}}}},
    "正在建立依赖地图" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Building Dependency Map"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在建立依賴地圖"}}}},
    "身份、注册与卸载步骤都将在执行前再次核验" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Identity, registration, and uninstall steps are verified again before execution"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身份、註冊與解除安裝步驟都將在執行前再次核驗"}}}},
    "只移到废纸篓；共享、系统和归属不明的项目不会处理" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Moves items to Trash only; shared, system, and uncertain-ownership items are not touched"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只移到垃圾桶；共享、系統和歸屬不明的項目不會處理"}}}},
    "选择一个 App" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an App"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇一個 App"}}}},
    "右侧会显示应用本体、相关文件、预计大小和恢复方式。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The app bundle, related files, estimated sizes, and recovery options appear on the right."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"右側會顯示應用本體、相關檔案、預計大小和恢復方式。"}}}},
    "版本 %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Version %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"版本 %@"}}}},
    "版本未知" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Version Unknown"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"版本未知"}}}},
    "路径已登记" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Path Registered"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"路徑已登記"}}}},
    "登记路径待复核" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Registered Path Needs Review"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"登記路徑待復核"}}}},
    "签名身份" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Signing Identity"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"簽名身份"}}}},
    "未取得可展示的签名身份" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No displayable signing identity available"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未取得可展示的簽名身份"}}}},
    "代码签名" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Code Signature"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"代碼簽名"}}}},
    "系统登记" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System Registration"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"系統登記"}}}},
    "登记位置" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Registered Location"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"登記位置"}}}},
    "等待你先保存工作并请求退出" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wait for you to save your work and request quit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"等待你先保存工作並請求退出"}}}},
    "执行时再次确认 App 没有运行" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm again at execution time that the app is not running"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"執行時再次確認 App 沒有運行"}}}},
    "核对路径、设备号、文件号、所有者与 Bundle ID" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify path, device ID, file ID, owner, and bundle ID"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"核對路徑、設備號、檔案號、所有者與 Bundle ID"}}}},
    "需要 macOS 原生管理员认证" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Requires native macOS administrator authentication"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要 macOS 原生管理員認證"}}}},
    "当前账户预计无需管理员认证" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The current account is not expected to require administrator authentication"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"當前帳戶預計無需管理員認證"}}}},
    "未确认 App 本体进入废纸篓前，相关文件保持零变更" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Related files remain unchanged until the app bundle is confirmed in Trash"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未確認 App 本體進入垃圾桶前，相關檔案保持零變更"}}}},
    "只处理你勾选且能证明为 App 私有的项目" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only processes selected items proven to be private to the app"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只處理你勾選且能證明為 App 私有的項目"}}}},
    "列出恢复位置、未完成项和可重试项" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lists recovery locations, incomplete items, and safe retries"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"列出恢復位置、未完成項和可重試項"}}}},
    "待执行" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pending"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"待執行"}}}},
    "进行中" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"In Progress"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"進行中"}}}},
    "跳过" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Skipped"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"跳過"}}}},
    "卸载范围" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uninstall Scope"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"解除安裝範圍"}}}},
    "保留的共享与系统项目" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preserved Shared and System Items"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"保留的共享與系統項目"}}}},
    "%@ 项只读，不会随卸载处理" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ read-only items will not be processed during uninstall"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 項唯讀，不會隨解除安裝處理"}}}},
    "扫描说明" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Notes"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃描說明"}}}},
    "查看归属判断与扫描记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review ownership decisions and scan records"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看歸屬判斷與掃描記錄"}}}},
    "已选 %@/%@ 项；可逐项保留。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ of %@ selected; you can keep items individually."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已選 %@/%@ 項；可逐項保留。"}}}},
    "已全部保留；打开后可逐项选择。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"All items are kept. Open to select items individually."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已全部保留；打開後可逐項選擇。"}}}},
    "没有可展示的归属证据" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No ownership evidence available"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有可展示的歸屬證據"}}}},
    "先处理本体" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Process App Bundle First"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先處理本體"}}}},
    "已勾选" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已勾選"}}}},
    "随本体" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"With App Bundle"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"隨本體"}}}},
    "%@ 已进入废纸篓" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ Moved to Trash"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 已進入垃圾桶"}}}},
    "%@ 已卸载，仍有未完成项" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ Uninstalled; Some Items Remain"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 已解除安裝，仍有未完成項"}}}},
    "App 本体与 %@ 个所选私有项目都有可恢复位置；共享、系统管理和未证实项目没有改动。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The app bundle and %@ selected private items have recovery locations. Shared, system-managed, and unverified items were not changed."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"App 本體與 %@ 個所選私有項目都有可恢復位置；共享、系統管理和未證實項目沒有改動。"}}}},
    "%@ 个私有项目已进入废纸篓，%@ 个项目仍在原位，可安全重试。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ private items moved to Trash; %@ remain in place and can be retried safely."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 個私有項目已進入垃圾桶，%@ 個項目仍在原位，可安全重試。"}}}},
    "%@ 个位置未能安全读取" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ locations could not be read safely"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 個位置未能安全讀取"}}}},
    "%@ 项因读取或本轮上限未纳入" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ items excluded because of read issues or this scan’s limits"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 項因讀取或本輪上限未納入"}}}},
    "本次扫描不完整" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Scan Is Incomplete"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本次掃描不完整"}}}},
    "。展开“本次扫描详情”可查看范围；未扫描内容不会被处理。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":". Expand “Scan Details” to review coverage. Unscanned content will not be processed."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"。展開“本次掃描詳情”可查看範圍；未掃描內容不會被處理。"}}}},
    "先选择要处理的项目；所有操作都会先移到废纸篓。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose what to process; every operation moves items to Trash first."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先選擇要處理的項目；所有操作都會先移到垃圾桶。"}}}},
    "个人文件默认不选；重复项会在处理前再次核验。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Personal files are not selected by default; duplicates are verified again before processing."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"個人檔案默認不選；重復項會在處理前再次核驗。"}}}},
    " 普通扫描与手动选择仍可正常使用。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":" Normal scanning and manual selection remain available."}},"zh-Hant":{"stringUnit":{"state":"translated","value":" 普通掃描與手動選擇仍可正常使用。"}}}},
    "这里很干净" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Looks Clean Here"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這裡很乾淨"}}}},
    "本次没有发现建议清理的内容。你可以稍后重新扫描。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No recommended cleanup items were found. You can scan again later."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本次沒有發現建議清理的內容。你可以稍後重新掃描。"}}}},
    "没有符合筛选条件的项目" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Items Match the Filters"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有符合篩選條件的項目"}}}},
    "清除搜索词即可查看完整结果。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear the search to see all results."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除搜索詞即可查看完整結果。"}}}},
    "清除搜索" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear Search"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除搜索"}}}},
    "%@ 项候选 · %@/%@ 个位置可读" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ candidates · %@ of %@ locations readable"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 項候選 · %@/%@ 個位置可讀"}}}},
    "将 %@ 项移到废纸篓？" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Move %@ Items to Trash?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將 %@ 項移到垃圾桶？"}}}},
    "只读取本机媒体元数据；只对同尺寸文件计算 SHA-256，不上传文件或哈希。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reads on-device media metadata only; calculates SHA-256 only for equal-sized files. Neither files nor hashes are uploaded."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"唯讀取本機媒體元資料；只對同尺寸檔案計算 SHA-256，不上傳檔案或哈希。"}}}},
    "应用缓存不会自动勾选。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Application caches are never selected automatically."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"應用緩存不會自動勾選。"}}}},
    "媒体与重复文件" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Media & Duplicates"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"媒體與重復檔案"}}}},
    "仅检查安装包与归档" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Installers and Archives Only"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"僅檢查安裝包與歸檔"}}}},
    "已选：%@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected: %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已選：%@"}}}},
    "清空后的预估可用空间" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated Free Space After Emptying"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清空後的預估可用空間"}}}},
    "恢复方式" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recovery"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"恢復方式"}}}},
    "清空前可从废纸篓放回" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Restore from Trash before emptying"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清空前可從垃圾桶放回"}}}},
    "安全核验" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Safety Verification"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安全核驗"}}}},
    "%@ 项会在执行前重验" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ items revalidated before execution"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 項會在執行前重驗"}}}},
    "只打开最终复核；不会在这一步移动文件" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens final review only; no files move at this step"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只打開最終復核；不會在這一步移動檔案"}}}},
    "%@/%@ 个位置可读" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ of %@ locations readable"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@/%@ 個位置可讀"}}}},
    "已检查文件" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Files Examined"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已檢查檔案"}}}},
    "有界扫描，不会为凑数读取包内容" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Bounded scan; package contents are not read to inflate counts"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"有界掃描，不會為湊數讀取包內容"}}}},
    "原始候选" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw Candidates"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"原始候選"}}}},
    "候选体积不等于已释放空间" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Candidate size does not equal released space"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"候選體積不等於已釋放空間"}}}},
    "扫描耗时" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Duration"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃描耗時"}}}},
    "%.2f 秒" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%.2f sec"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%.2f 秒"}}}},
    "高成本遍历在独立扫描进程中完成" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expensive traversal runs in an isolated scanner process"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"高成本遍歷在獨立掃描進程中完成"}}}},
    "证据时间" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Evidence Timestamp"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"證據時間"}}}},
    "检查位置" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Locations Checked"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查位置"}}}},
    "本次扫描原始类别" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Raw Categories in This Scan"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本次掃描原始類別"}}}},
    "%@ %@ 项 · %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@: %@ items · %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ %@ 項 · %@"}}}},
    "安全跳过" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Safely Skipped"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安全跳過"}}}},
    "截图按常见中英文文件名识别；其他媒体按修改时间和体积进入候选。同一文件可同时具有重复证据，不要将分类数量直接相加。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Screenshots are recognized by common Chinese and English names; other media become candidates by modification time and size. A file may also have duplicate evidence, so category counts are not additive."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"截圖按常見中英文檔案名識別；其他媒體按修改時間和體積進入候選。同一檔案可同時具有重復證據，不要將分類數量直接相加。"}}}},
    "本次未启用媒体与重复文件分析；只检查桌面和下载中的安装包与归档。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Media and duplicate analysis was not enabled; only installers and archives on the Desktop and in Downloads were checked."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本次未啟用媒體與重復檔案分析；只檢查桌面和下載中的安裝包與歸檔。"}}}},
    "已检查" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checked"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已檢查"}}}},
    "位置不存在" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Location Missing"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"位置不存在"}}}},
    "当前不可读" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Currently Unreadable"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"當前不可讀"}}}},
    "安全校验未通过" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Safety Check Failed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安全校驗未通過"}}}},
    "云端文件尚未完整下载" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cloud file is not fully downloaded"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"雲端檔案尚未完整下載"}}}},
    "符号链接不跟随" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Symbolic links are not followed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"符號鏈接不跟隨"}}}},
    "App/资料库包内容不展开" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App/library package contents are not expanded"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"App/資料庫包內容不展開"}}}},
    "文件或目录当前不可读" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"File or directory is currently unreadable"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檔案或目錄當前不可讀"}}}},
    "超出本轮有界深度" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Beyond this scan’s depth limit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"超出本輪有界深度"}}}},
    "根目录未通过安全检查" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Root failed the safety check"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"根目錄未通過安全檢查"}}}},
    "达到本轮文件上限" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reached this scan’s file limit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"達到本輪檔案上限"}}}},
    "达到本轮哈希上限" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reached this scan’s hash limit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"達到本輪哈希上限"}}}},
    "近 30 天" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last 30 Days"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"近 30 天"}}}},
    "30–90 天" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"30–90 Days"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"30–90 天"}}}},
