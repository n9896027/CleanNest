    "已连接电源，暂未充电" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected to Power, Not Charging" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已連接電源，暫未充電" } } } },
